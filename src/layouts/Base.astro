---
// Base layout: dark arcade shell shared by landing + play pages.
import '../styles/global.css';
interface Props { title?: string; description?: string }
const {
  title = 'Catatumbo Protocol',
  description = 'Simultaneous-turn mecha duel over Lake Maracaibo. Online 2-player.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/cover.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Silkscreen:wght@400;700&family=Space+Grotesk:ital,wght@0,600;0,700;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: #071019;
    color: #cfe6ff;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    min-height: 100vh;
  }
  a { color: #4dd0ff; }
</style>
