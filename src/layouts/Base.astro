---
// Base layout: dark arcade shell shared by landing + play pages.
interface Props { title?: string }
const { title = 'Catatumbo Protocol' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Simultaneous-turn mecha duel over Lake Maracaibo. Online 2-player." />
    <link rel="icon" type="image/png" href="/cover.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: #071019;
    color: #cfe6ff;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    min-height: 100vh;
  }
  a { color: #4dd0ff; }
</style>
