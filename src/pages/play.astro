---
import Base from '../layouts/Base.astro';
---
<Base title="Catatumbo Protocol — Play">
  <main class="play-shell">
    <div id="game-root"></div>
    <div id="net-status" class="net-status" hidden></div>
  </main>
</Base>

<style>
  .play-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 16px;
    gap: 12px;
  }
  #game-root {
    width: min(800px, 100%);
    aspect-ratio: 4 / 3;
    box-shadow: 0 0 60px rgba(77, 208, 255, 0.15);
    border: 1px solid #14324a;
  }
  .net-status {
    font-size: 13px;
    color: #7fb8dd;
    letter-spacing: 0.04em;
  }
</style>

<script>
  import { bootGame } from '../game/game.js';

  const params = new URLSearchParams(location.search);
  const mode = params.get('mode') === 'net' ? 'net' : 'cpu';
  const statusEl = document.getElementById('net-status');

  function setStatus(msg) {
    if (!statusEl) return;
    statusEl.hidden = !msg;
    statusEl.textContent = msg || '';
  }

  async function start() {
    if (mode === 'net') {
      setStatus('Connecting to Playroom…');
      try {
        const { createNetSession } = await import('../game/net.js');
        const net = await createNetSession({});
        const invite = `${location.origin}/play?mode=net&gameId=${params.get('gameId') || ''}&r=${net.roomCode}`;
        setStatus(`Room ${net.roomCode} — waiting for opponent… (share: ${invite})`);
        // Give the opponent a moment to join; the turn loop waits naturally anyway.
        await net.waitForOpponent();
        setStatus(`Room ${net.roomCode} — you are P${net.seat + 1}. Fight!`);
        bootGame({ mode: 'net', net, myIndex: net.seat, debug: params.get('debug') === '1' });
      } catch (err) {
        console.error(err);
        setStatus('Multiplayer unavailable — falling back to CPU. (' + err.message + ')');
        bootGame({ mode: 'cpu' });
      }
    } else {
      bootGame({ mode: 'cpu' });
    }
  }

  start();
</script>
