---
import Base from '../layouts/Base.astro';
---
<Base title="Catatumbo Protocol — Play">
  <main class="play-shell">
    <div class="play-bar">
      <a href="/" class="play-home mono-font" aria-label="Back to archive landing">
        <span aria-hidden="true">◀</span> ARCHIVE
      </a>
      <span class="play-bar-title" aria-label="Catatumbo Protocol">
        <span class="logo-a">CATATUMBO</span><span class="logo-b">PROTOCOL</span>
      </span>
      <button
        type="button"
        id="fs-toggle"
        class="fs-btn"
        aria-label="Enter fullscreen"
        aria-pressed="false"
        title="Fullscreen (F)"
      >
        <span class="fs-icon" aria-hidden="true">⛶</span>
        <span class="fs-label pixel-font">FULLSCREEN</span>
      </button>
    </div>

    <div id="game-root"></div>
    <div id="net-status" class="net-status" role="status" aria-live="polite" hidden>
      <span id="net-status-text" class="mono-font"></span>
      <button type="button" id="net-copy" class="net-copy pixel-font" hidden>COPIAR LINK</button>
    </div>
    <div id="room-banner" class="room-banner" hidden>
      <span class="room-banner__tag pixel-font">SALA</span>
      <span id="room-code" class="room-banner__code mono-font"></span>
      <button type="button" id="room-copy" class="net-copy pixel-font">COPIAR LINK</button>
    </div>
    <div id="name-editor" class="name-editor" hidden>
      <div class="name-editor__panel">
        <span class="name-editor__tag pixel-font">CALLSIGN</span>
        <input
          id="name-input"
          class="name-editor__input mono-font"
          maxlength="12"
          placeholder="PILOTO"
          autocomplete="off"
          spellcheck="false"
          aria-label="Tu callsign"
        />
        <div class="name-editor__actions">
          <button type="button" id="name-save" class="fs-btn pixel-font">GUARDAR</button>
        </div>
      </div>
    </div>
  </main>
</Base>

<style>
  .play-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    height: 100dvh;
    padding: 0;
    gap: 0;
    background: #071019;
  }

  /* Top bar: back link, title, fullscreen toggle */
  .play-bar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 12px;
    border: none;
    border-bottom: 1px solid #14324a;
    background: #05070a;
    flex: 0 0 auto;
  }
  .play-bar-title {
    text-align: center;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: 15px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .logo-a {
    color: #ffd23f;
    text-shadow: 2px 2px 0 #000;
  }
  .logo-b {
    color: #00f0ff;
    text-shadow: 2px 2px 0 #000;
  }
  .play-home {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #10f57a;
    text-decoration: none;
    padding: 6px 10px;
    background: color-mix(in oklab, #10f57a 10%, transparent);
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    box-shadow: inset 0 0 0 1px #10f57a;
    transition: background-color 150ms var(--ease-out, ease-out), color 150ms var(--ease-out, ease-out),
      box-shadow 200ms var(--ease-out, ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .play-home:hover {
      background: #10f57a;
      color: #05070a;
      box-shadow: inset 0 0 0 1px #10f57a, 0 0 12px rgba(16, 245, 122, 0.5);
    }
  }
  .play-home:focus-visible {
    outline: 2px solid #00f0ff;
    outline-offset: 2px;
  }

  /* Fullscreen button — cyberpunk corner-cut (ref: cyberpunk-ui cp-btn--cut) */
  .fs-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 6px 12px;
    background: color-mix(in oklab, #00f0ff 10%, transparent);
    color: #00f0ff;
    border: 0;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    box-shadow: inset 0 0 0 1.5px #00f0ff;
    cursor: pointer;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color 150ms var(--ease-out, ease-out), color 150ms var(--ease-out, ease-out),
      box-shadow 200ms var(--ease-out, ease-out), transform 120ms var(--ease-out, ease-out);
  }
  .fs-icon {
    font-size: 15px;
    line-height: 1;
    transform: translateY(-0.5px);
  }
  .fs-label {
    font-size: 9px;
    letter-spacing: 0.06em;
  }
  @media (hover: hover) and (pointer: fine) {
    .fs-btn:hover {
      background: #00f0ff;
      color: #05070a;
      box-shadow: inset 0 0 0 1.5px #00f0ff, 0 0 12px rgba(0, 240, 255, 0.5);
    }
  }
  .fs-btn:active {
    transform: translateY(1px);
  }
  .fs-btn:focus-visible {
    outline: 2px solid #ffd23f;
    outline-offset: 2px;
  }
  .fs-btn[aria-pressed='true'] {
    background: #ffd23f;
    color: #05070a;
    box-shadow: inset 0 0 0 1.5px #ffd23f, 0 0 12px rgba(255, 210, 63, 0.5);
  }

  #game-root {
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    background: #05070a;
    overflow: hidden;
  }

  /* Fullscreen: fill the viewport, letterbox the 4:3 Phaser canvas via FIT */
  #game-root:fullscreen,
  #game-root.is-fullscreen {
    width: 100vw;
    height: 100vh;
    aspect-ratio: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #071019;
    border: none;
    box-shadow: none;
    overflow: hidden;
  }
  #game-root:fullscreen canvas,
  #game-root.is-fullscreen canvas {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .net-status {
    position: fixed;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: min(92vw, 720px);
    padding: 8px 12px;
    border: 1px solid #14324a;
    background: #05070a;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
    box-shadow: inset 0 0 0 1px rgba(20, 50, 74, 0.8);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #7fb8dd;
    overflow-wrap: anywhere;
    z-index: 20;
  }
  .net-status[hidden] {
    display: none;
  }
  .net-copy {
    flex: 0 0 auto;
    padding: 4px 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffd23f;
    background: color-mix(in oklab, #ffd23f 10%, transparent);
    border: 0;
    clip-path: polygon(7px 0, 100% 0, 100% calc(100% - 7px), calc(100% - 7px) 100%, 0 100%, 0 7px);
    box-shadow: inset 0 0 0 1px #ffd23f;
    cursor: pointer;
    transition: background-color 150ms ease-out, color 150ms ease-out, box-shadow 200ms ease-out;
  }
  .net-copy[hidden] {
    display: none;
  }
  .net-copy:hover {
    background: #ffd23f;
    color: #05070a;
    box-shadow: inset 0 0 0 1px #ffd23f, 0 0 12px rgba(255, 210, 63, 0.5);
  }

  /* Persistent room banner (net mode): code + copy-link, top-right over the canvas. */
  .room-banner {
    position: fixed;
    top: 46px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    background: #05070a;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    box-shadow: inset 0 0 0 1.5px #ffd23f, 0 0 12px rgba(255, 210, 63, 0.2);
    z-index: 30;
  }
  .room-banner[hidden] {
    display: none;
  }
  .room-banner__tag {
    font-size: 9px;
    letter-spacing: 0.08em;
    color: #ffd23f;
  }
  .room-banner__code {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.12em;
  }

  /* Callsign editor overlay (net lobby): chunky arcade plate. */
  .name-editor {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #02060bc9;
    z-index: 40;
  }
  .name-editor[hidden] {
    display: none;
  }
  .name-editor__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 22px 26px;
    background: #05070a;
    clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
    box-shadow: inset 0 0 0 2px #ffd23f, 0 0 18px rgba(255, 210, 63, 0.18);
  }
  .name-editor__tag {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #ffd23f;
  }
  .name-editor__input {
    width: 240px;
    padding: 10px 12px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
    color: #fff;
    background: #0b1928;
    border: 0;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    box-shadow: inset 0 0 0 1.5px #00f0ff;
    outline: none;
    caret-color: #ffd23f;
  }
  .name-editor__input:focus {
    box-shadow: inset 0 0 0 1.5px #00f0ff, inset 0 0 0 3px #ffd23f;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-btn,
    .play-home {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  import { bootGame } from '../game/game.js';
  import { sfxBlip } from '../game/ui-sfx.ts';

  const params = new URLSearchParams(location.search);
  // A shared invite link carries the room code in query (?r=) or hash (#r=):
  // those links must boot straight into net mode even without ?mode=net.
  const hashParams = new URLSearchParams(location.hash.replace(/^#/, ''));
  const hasRoom = !!(params.get('r') || hashParams.get('r'));
  const initialMode = params.get('mode') === 'net' || hasRoom ? 'net' : 'cpu';
  const debugMode = params.get('debug') === '1';

  // Arcade click feedback on DOM buttons (works without any asset).
  document.getElementById('fs-toggle')?.addEventListener('click', () => sfxBlip(true));
  document.getElementById('net-copy')?.addEventListener('click', () => sfxBlip(true));
  document.querySelector('.play-home')?.addEventListener('click', () => sfxBlip(false));

  // ---- Callsign editor (opened with O from the net lobby) ----
  const nameEditor = document.getElementById('name-editor');
  const nameInput = document.getElementById('name-input') as HTMLInputElement | null;
  const nameSave = document.getElementById('name-save');
  let nameSession: any = null; // active net session, set on mount opts

  function openNameEditor() {
    if (!nameEditor || !nameInput) return;
    nameInput.value = localStorage.getItem('cp:callsign') || '';
    nameEditor.hidden = false;
    nameInput.focus();
    nameInput.select();
  }

  function closeNameEditor() {
    if (nameEditor) nameEditor.hidden = true;
    // Return focus to the canvas so WASD/Enter keep driving the lobby.
    (document.querySelector('canvas') as HTMLCanvasElement | null)?.focus?.();
  }

  async function saveName() {
    const v = (nameInput?.value || '').trim().toUpperCase().slice(0, 12);
    try {
      localStorage.setItem('cp:callsign', v);
    } catch {}
    sfxBlip(true);
    if (nameSession?.setName) await nameSession.setName(v);
    closeNameEditor();
  }

  nameSave?.addEventListener('click', saveName);
  nameInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') saveName();
    if (e.key === 'Escape') closeNameEditor();
    e.stopPropagation(); // keep keystrokes out of the game input pump
  });
  nameEditor?.addEventListener('click', (e) => {
    if (e.target === nameEditor) closeNameEditor();
  });

  const statusEl = document.getElementById('net-status');
  const statusText = document.getElementById('net-status-text');
  const copyBtn = document.getElementById('net-copy') as HTMLButtonElement | null;
  let inviteUrl = '';

  function setStatus(msg: string) {
    if (!statusEl) return;
    statusEl.hidden = !msg;
    if (statusText) statusText.textContent = msg || '';
    if (copyBtn) copyBtn.hidden = !(msg && inviteUrl);
  }

  copyBtn?.addEventListener('click', async () => {
    if (!inviteUrl) return;
    try {
      await navigator.clipboard.writeText(inviteUrl);
      copyBtn.textContent = 'COPIADO';
      setTimeout(() => {
        copyBtn.textContent = 'COPIAR LINK';
      }, 1400);
    } catch {
      setStatus(`SALA — ${inviteUrl}`);
    }
  });

  // ---- Fullscreen (browser Fullscreen API on the #game-root container) ----
  const gameRoot = document.getElementById('game-root');
  const fsBtn = document.getElementById('fs-toggle');
  const fsLabel = fsBtn?.querySelector('.fs-label');
  const fsIcon = fsBtn?.querySelector('.fs-icon');

  function syncFullscreenUi() {
    const active = !!document.fullscreenElement;
    if (fsBtn) {
      fsBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
      fsBtn.setAttribute('aria-label', active ? 'Exit fullscreen' : 'Enter fullscreen');
      fsBtn.setAttribute('title', active ? 'Exit fullscreen (F)' : 'Fullscreen (F)');
    }
    if (fsLabel) fsLabel.textContent = active ? 'EXIT' : 'FULLSCREEN';
    if (fsIcon) fsIcon.textContent = active ? '⤢' : '⛶';
    gameRoot?.classList.toggle('is-fullscreen', active);
  }

  async function toggleFullscreen() {
    if (!gameRoot) return;
    try {
      if (document.fullscreenElement) {
        await document.exitFullscreen();
      } else if (gameRoot.requestFullscreen) {
        await gameRoot.requestFullscreen();
      } else if ((gameRoot as any).webkitRequestFullscreen) {
        // Safari fallback
        (gameRoot as any).webkitRequestFullscreen();
      }
    } catch (err) {
      // Some browsers block fullscreen without a direct user gesture, or the
      // element can't be fullscreened. Fail silently and keep state in sync.
      console.warn('Fullscreen request rejected:', err);
    } finally {
      syncFullscreenUi();
    }
  }

  fsBtn?.addEventListener('click', toggleFullscreen);
  document.addEventListener('fullscreenchange', syncFullscreenUi);
  document.addEventListener('webkitfullscreenchange', syncFullscreenUi);

  // Keyboard shortcut: F toggles fullscreen, only when not typing and not
  // colliding with game controls (W/A/S/D + U/I/O/J/K/L + Enter). F is free.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'f' && e.key !== 'F') return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    const tag = t?.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || t?.isContentEditable) return;
    e.preventDefault();
    toggleFullscreen();
  });

  syncFullscreenUi();

  let game: any = null;

  function mount(opts: any) {
    if (game) {
      game.destroy(true);
      game = null;
    }
    game = bootGame(opts);
  }

  // Called from the in-game menu when the player picks ONLINE. Deferred so the
  // Phaser instance is not destroyed inside its own input handler.
  function requestMode(target: 'cpu' | 'net') {
    setTimeout(() => {
      start(target);
    }, 0);
  }

  // Playroom can hang (service down, blocked network, expired gameId). Never
  // leave the player staring at "CONECTANDO" forever: time out and fall back.
  function withTimeout<T>(p: Promise<T>, ms: number): Promise<T> {
    return Promise.race([
      p,
      new Promise<T>((_, rej) => setTimeout(() => rej(new Error('net connect timeout')), ms)),
    ]);
  }

  async function start(target: 'cpu' | 'net' = initialMode as 'cpu' | 'net') {
    if (target === 'net') {
      setStatus('CONECTANDO A LA SALA…');
      try {
        const { createNetSession } = await import('../game/net.js');
        const net = await withTimeout(createNetSession({}), 15000);
        // Invite link keeps the canonical code (no display prefix).
        inviteUrl = `${location.origin}/play/?mode=net&r=${net.roomCode}`;
        // Persistent room banner: code + copy link, visible during lobby and match.
        const banner = document.getElementById('room-banner');
        const codeEl = document.getElementById('room-code');
        const roomCopy = document.getElementById('room-copy');
        if (codeEl) codeEl.textContent = net.roomCode || '????';
        if (banner) banner.hidden = false;
        roomCopy?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(inviteUrl);
            if (roomCopy) roomCopy.textContent = '¡COPIADO!';
            setTimeout(() => {
              if (roomCopy) roomCopy.textContent = 'COPIAR LINK';
            }, 1600);
          } catch {
            if (codeEl) codeEl.textContent = inviteUrl;
          }
        });
        setStatus('');
        nameSession = net;
        mount({ mode: 'net', net, myIndex: net.seat, onMode: requestMode, onNameEdit: openNameEditor, debug: debugMode });
      } catch (err: any) {
        console.error(err);
        setStatus('MULTIJUGADOR NO DISPONIBLE — MODO CPU');
        setTimeout(() => setStatus(''), 2600);
        mount({ mode: 'cpu', onMode: requestMode, debug: debugMode });
      }
    } else {
      setStatus('');
      mount({ mode: 'cpu', onMode: requestMode, debug: debugMode });
    }
  }

  start();
</script>
