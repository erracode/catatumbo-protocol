---
import Base from '../layouts/Base.astro';
---

<Base
  title="CATATUMBO PROTOCOL — 1996 SEGA Saturn / PSX Archive Edition"
  description="Combate táctico de mechas 1v1 por turnos simultáneos sobre el Lago de Maracaibo. Archive Edition para navegador."
>
  <div id="content" class="landing-shell starfield-radar-bg">
    <!-- Capa CRT -->
    <div class="crt-overlay" aria-hidden="true"></div>

    <!-- ===================================================================== -->
    <!-- BARRA DE NAVEGACIÓN SUPERIOR (4 PARADAS + ERRACODE // ARCHIVE)        -->
    <!-- ===================================================================== -->
    <header class="fixed top-0 left-0 right-0 border-b border-[#10F57A]/60 bg-[#05070A]/95 backdrop-blur-md z-40">
      <div class="max-w-7xl mx-auto px-3 sm:px-5 py-2 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="bg-[#00F0FF] text-black pixel-font font-bold px-2 py-0.5 text-[10px] border border-black">
            PSX / SATURN
          </span>
          <span class="mono-font text-xs text-[#10F57A] hidden xl:inline font-bold tracking-wider">
            CATATUMBO PROTOCOL // OBI SLUS-1996-MCBO
          </span>
        </div>

        <!-- 4 Paradas de navegación -->
        <nav class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto" aria-label="Archive sections">
          <button type="button" data-stop="0" id="nav-stop-0" class="nav-stop nav-stop-active" aria-current="true">
            01 PORTADA
          </button>
          <button type="button" data-stop="1" id="nav-stop-1" class="nav-stop">
            02 LOMO / MECHAS
          </button>
          <button type="button" data-stop="2" id="nav-stop-2" class="nav-stop">
            03 CONTRAPORTADA
          </button>
          <button type="button" data-stop="3" id="nav-stop-3" class="nav-stop">
            04 MANUAL &amp; DISCO
          </button>
        </nav>

        <a
          href="https://erracode.pages.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="pixel-font text-[9px] sm:text-[10px] bg-[#10F57A] hover:bg-white text-black border border-black px-2.5 py-1 font-bold shrink-0 transition-colors duration-150"
        >
          ERRACODE // ARCHIVE ↗
        </a>
      </div>
    </header>

    <!-- ESCENARIO 3D INTERACTIVO -->
    <div id="three-stage" title="Arrastra para girar la caja en 360°"></div>

    <!-- PISTA DE SCROLL -->
    <div id="scroll-track" aria-hidden="true"></div>

    <!-- ===================================================================== -->
    <!-- STOP 01: PORTADA (ARCHIVE EDITION STORE LISTING)                      -->
    <!-- ===================================================================== -->
    <section id="panel-0" class="story-panel active">
      <div class="max-w-7xl mx-auto w-full px-4 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-start-7 lg:col-span-6 interactive-card panel-scroll-box mt-[42vh] lg:mt-0">
          <div class="bg-[#060C13]/95 border-2 border-[#00F0FF] p-4 sm:p-5 shadow-[8px_8px_0px_#000000] space-y-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-2">
              <span class="inline-flex items-center gap-2 bg-black border border-[#FFD23F] px-2.5 py-1">
                <span class="w-2 h-2 bg-[#10F57A] animate-ping"></span>
                <span class="pixel-font text-[9px] sm:text-[10px] text-[#FFD23F]">ARCHIVE EDITION • NTSC-U</span>
              </span>
              <span class="mono-font text-xs text-[#00F0FF] font-bold">SCROLL PARA GIRAR CAJA ↓</span>
            </div>

            <div>
              <h1 class="virtual-title text-4xl sm:text-5xl md:text-6xl leading-none">CATATUMBO</h1>
              <h2 class="virtual-subtitle text-3xl sm:text-4xl md:text-5xl leading-tight mt-1">PROTOCOL</h2>
            </div>

            <p class="text-slate-200 text-sm sm:text-base leading-relaxed border-l-2 border-[#FF2A55] pl-3.5 bg-white/5 py-2">
              Duelo de mechas <strong>1v1 por turnos simultáneos</strong> sobre el Lago de Maracaibo.
              Ambos pilotos eligen su acción en secreto y la resuelven a la vez: la <strong>velocidad</strong> decide quién golpea primero.
              Encadena <strong>posturas</strong>, gasta <strong>Guts</strong> en especiales y sobrevive al relámpago del Catatumbo.
            </p>

            <!-- Ticker de mecánicas reales -->
            <div class="ticker bg-black border border-[#10F57A]/40 py-1" aria-hidden="true">
              <span class="ticker__track mono-font text-[10px] font-bold tracking-wider text-[#10F57A]">
                &gt;&gt; MECHA SIMULTACTICS · ACCIONES SECRETAS · ORDEN POR VELOCIDAD · POSTURAS: NORMAL→ATURDIDO→RETROCESO→DERRIBADO · GUTS DESDE PARRY/AGARRE/PETRÓLEO · RAYO CATATUMBO 12 DMG · VERDÍN 8 DMG · PETRÓLEO 10 DMG · LANZAMIENTOS ROMPEN PUENTE Y PALAFITOS &lt;&lt;
              </span>
            </div>

            <!-- Ficha de Precio + Selector de Modo -->
            <div class="bg-[#09121C] border border-slate-700 p-4 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-2.5">
                <div class="flex items-center gap-2.5">
                  <span class="text-slate-500 line-through text-base font-bold mono-font">Bs. 1996.00</span>
                  <span class="bg-[#10F57A] text-black pixel-font text-[10px] px-2.5 py-1 border border-black font-bold">
                    FREE / JUGAR EN NAVEGADOR
                  </span>
                </div>
                <span class="mono-font text-xs text-[#00F0FF] font-bold">OBI: SLUS-1996-MCBO</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <a
                  href="/play?mode=cpu"
                  class="btn-brutal bg-[#FFD23F] text-black p-3 text-left flex items-center justify-between cursor-pointer"
                >
                  <div>
                    <div class="pixel-font text-[10px] sm:text-[11px] font-bold">[ 1P VS CPU ]</div>
                    <div class="mono-font text-[11px] font-bold opacity-80">Arcade gauntlet · 5 rivales + jefe</div>
                  </div>
                  <span class="pixel-font text-xs" aria-hidden="true">▶</span>
                </a>

                <a
                  href="/play?mode=net&gameId=9zfQpYpu1MrPWjldLTfD"
                  class="btn-brutal bg-slate-900 text-white border-[#00F0FF] p-3 text-left flex items-center justify-between cursor-pointer"
                >
                  <div>
                    <div class="pixel-font text-[10px] sm:text-[11px] font-bold text-[#00F0FF]">[ 2P ONLINE - PLAYROOM ]</div>
                    <div class="mono-font text-[11px] text-slate-300">Sala P2P con código</div>
                  </div>
                  <span class="pixel-font text-[10px] text-[#00F0FF]">NET</span>
                </a>
              </div>

              <a
                href="/play"
                class="btn-brutal w-full bg-[#FF2A55] hover:bg-[#ff3b63] text-white py-3.5 px-5 flex flex-col items-center justify-center gap-1 cursor-pointer"
              >
                <span class="pixel-font text-sm sm:text-base tracking-wider blink-coin font-bold">
                  INSERT COIN / JUGAR AHORA
                </span>
                <span class="mono-font text-[11px] font-bold uppercase tracking-widest text-yellow-200">
                  INICIAR CABINA VIRTUAL-ON EN NAVEGADOR
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- STOP 02: LOMO & OBI STRIP — MACHINE SELECT + SVG BLUEPRINTS           -->
    <!-- ===================================================================== -->
    <section id="panel-1" class="story-panel">
      <div class="max-w-7xl mx-auto w-full px-4 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-span-6 interactive-card panel-scroll-box mt-[42vh] lg:mt-0">
          <div class="bg-[#050B11]/95 border-2 border-[#10F57A] p-4 sm:p-5 shadow-[8px_8px_0px_#000000] space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#10F57A]/40 pb-2">
              <div>
                <span class="pixel-font text-xs sm:text-sm text-[#10F57A] font-bold block">MACHINE SELECT</span>
                <span class="mono-font text-[11px] text-slate-300">OBI STRIP: SLUS-1996-MCBO // SEGA AM3 SPEC</span>
              </div>
              <span id="selected-mech-badge" class="bg-[#FFD23F] text-black pixel-font text-[9px] sm:text-[10px] px-2.5 py-1 border border-black font-bold">
                MBV-04-MCBO RELAMPAGO
              </span>
            </div>

            <!-- Visor Blueprint Wireframe tipo VR.TEMJIN Saturn -->
            <div class="bg-[#03080C] border border-[#00F0FF] p-3 grid grid-cols-1 sm:grid-cols-12 gap-3 items-center relative">
              <div class="sm:col-span-5 flex items-center justify-center border border-[#10F57A]/30 bg-[#040D12] p-2">
                <div id="mech-blueprint-svg" class="w-28 h-28 sm:w-32 sm:h-32"></div>
              </div>
              <div class="sm:col-span-7 space-y-1.5">
                <div class="pixel-font text-[10px] text-[#FF2A55] tracking-widest">&gt; NEXT VIRTUALOID &lt;</div>
                <div id="bp-code" class="mono-font text-xs text-[#10F57A] font-bold">MBV-04-MCBO</div>
                <div id="bp-name" class="display-font text-xl sm:text-2xl font-bold italic text-[#00F0FF] leading-none">
                  VR.RELAMPAGO
                </div>
                <div id="bp-weapons" class="mono-font text-[11px] text-[#FFD23F] font-bold leading-snug pt-1">
                  RAYO OCULTO<br />CORTE V / CORTE H<br />ESQUIVA + TELEPORTE
                </div>
                <div id="bp-stats" class="mono-font text-[10px] text-slate-300 border-t border-slate-800 pt-1">
                  HP: 160 | VEL: ALTA | POSTURA: BALANCE
                </div>
                <div id="bp-sector" class="pixel-font text-[9px] text-[#10F57A]">
                  SECTOR: PUENTE RAFAEL URDANETA
                </div>
              </div>
            </div>

            <!-- Selector de 3 Virtualoids Zulianos -->
            <div class="space-y-1.5">
              <button type="button" id="mech-card-0" data-mech="0" class="mech-card active w-full p-2 text-left flex items-center justify-between gap-3 cursor-pointer">
                <div>
                  <div class="pixel-font text-[10px] sm:text-[11px] text-[#00F0FF] font-bold">01. VR.RELAMPAGO (MBV-04)</div>
                  <div class="mono-font text-[11px] text-slate-300">Equilibrado • Rayo Oculto + Esquiva</div>
                </div>
                <span class="bg-[#00F0FF] text-black pixel-font text-[9px] px-2 py-0.5 font-bold">VEL S</span>
              </button>

              <button type="button" id="mech-card-1" data-mech="1" class="mech-card w-full p-2 text-left flex items-center justify-between gap-3 cursor-pointer">
                <div>
                  <div class="pixel-font text-[10px] sm:text-[11px] text-[#10F57A] font-bold">02. VR.PALAFITO (XBV-13)</div>
                  <div class="mono-font text-[11px] text-slate-300">Anfibio Ágil • Orbe Rayo + Teleporte</div>
                </div>
                <span class="bg-[#10F57A] text-black pixel-font text-[9px] px-2 py-0.5 font-bold">EVA A+</span>
              </button>

              <button type="button" id="mech-card-2" data-mech="2" class="mech-card w-full p-2 text-left flex items-center justify-between gap-3 cursor-pointer">
                <div>
                  <div class="pixel-font text-[10px] sm:text-[11px] text-[#FF2A55] font-bold">03. VR.URDANETA (RVR-01)</div>
                  <div class="mono-font text-[11px] text-slate-300">Pesado • Cañón Solazo + Escudo</div>
                </div>
                <span class="bg-[#FF2A55] text-white pixel-font text-[9px] px-2 py-0.5 font-bold">DEF MAX</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- STOP 03: CONTRAPORTADA (180°) — BLOQUE AMARILLO SEGA SATURN           -->
    <!-- ===================================================================== -->
    <section id="panel-2" class="story-panel">
      <div class="max-w-7xl mx-auto w-full px-4 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-start-7 lg:col-span-6 interactive-card panel-scroll-box mt-[42vh] lg:mt-0">
          <div class="saturn-backcover p-4 sm:p-5">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-black pb-2 mb-2.5">
              <div>
                <span class="bg-black text-[#FFD23F] pixel-font text-[9px] px-2 py-0.5">
                  SEGA SATURN / PSX ARCHIVE • 1996
                </span>
                <h3 class="text-lg sm:text-xl font-bold italic uppercase tracking-tight text-black mt-1 leading-tight">
                  ¡ARMAGEDÓN TÁCTICO SOBRE EL LAGO DE MARACAIBO!
                </h3>
              </div>
              <div class="bg-black text-white px-2 py-1 border border-black text-right">
                <div class="pixel-font text-[8px] text-[#00F0FF]">CYBER TROOPERS</div>
                <div class="mono-font text-[10px] font-bold text-[#10F57A]">ZULIA ARENA</div>
              </div>
            </div>

            <p class="mono-font text-[11px] font-bold text-black/90 mb-2.5 leading-snug">
              Pilota tu Virtualoid en duelos tácticos simultáneos sobre el Lago de Maracaibo. Acciones secretas, orden por velocidad y el relámpago eterno del Catatumbo, straight out of the Arcade.
            </p>

            <!-- 4 Capturas enmarcadas en rojo (compactas) -->
            <div class="grid grid-cols-2 gap-2.5">
              <div class="space-y-1">
                <div class="vo-frame">
                  <canvas id="shot-1" width="320" height="145" class="w-full h-auto block"></canvas>
                </div>
                <p class="text-[11px] font-bold leading-tight">
                  <strong>Duelo Simultáneo:</strong> Ambos eligen en secreto; la velocidad decide.
                </p>
              </div>

              <div class="space-y-1">
                <div class="vo-frame">
                  <canvas id="shot-2" width="320" height="145" class="w-full h-auto block"></canvas>
                </div>
                <p class="text-[11px] font-bold leading-tight">
                  <strong>Rayo del Catatumbo:</strong> 12 DMG en la casilla marcada.
                </p>
              </div>

              <div class="space-y-1">
                <div class="vo-frame">
                  <canvas id="shot-3" width="320" height="145" class="w-full h-auto block"></canvas>
                </div>
                <p class="text-[11px] font-bold leading-tight">
                  <strong>Palafitos:</strong> Lanza al rival y rompe la cobertura.
                </p>
              </div>

              <div class="space-y-1">
                <div class="vo-frame">
                  <canvas id="shot-4" width="320" height="145" class="w-full h-auto block"></canvas>
                </div>
                <p class="text-[11px] font-bold leading-tight">
                  <strong>Posturas:</strong> Encadena Aturdido→Retroceso→Derribado.
                </p>
              </div>
            </div>

            <!-- Código de barras + 1 or 2 Players + ESRB retro -->
            <div class="mt-3 pt-2.5 border-t-2 border-black flex flex-wrap items-center justify-between gap-2">
              <div class="bg-white border border-black px-2.5 py-1 flex flex-col items-center">
                <div class="flex items-stretch h-6 gap-[2px]">
                  <span class="w-1 bg-black"></span><span class="w-0.5 bg-black"></span><span class="w-1.5 bg-black"></span>
                  <span class="w-0.5 bg-black"></span><span class="w-1 bg-black"></span><span class="w-2 bg-black"></span>
                  <span class="w-0.5 bg-black"></span><span class="w-1 bg-black"></span><span class="w-1.5 bg-black"></span>
                  <span class="w-0.5 bg-black"></span><span class="w-1 bg-black"></span><span class="w-2 bg-black"></span>
                </div>
                <span class="mono-font text-[9px] font-bold tracking-widest text-black">0 10086 81042 4</span>
              </div>

              <div class="bg-white border border-black px-2.5 py-1 flex items-center gap-2">
                <div class="bg-[#1E1B4B] text-white font-black px-1.5 py-0.5 text-xs">1 OR 2</div>
                <div class="text-[10px] font-black leading-none text-black">PLAYERS<br />ONLINE / CPU</div>
              </div>

              <div class="bg-white border border-black px-2.5 py-1 text-black flex items-center gap-2">
                <div class="border border-black px-1.5 py-0.5 text-center leading-none">
                  <div class="text-[7px] font-bold">KIDS TO ADULTS</div>
                  <div class="text-sm font-black">K-A</div>
                </div>
                <div class="mono-font text-[9px] font-bold leading-tight">ANIMATED<br />MECHA COMBAT</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- STOP 04: MANUAL & DISCO (CAJA ABIERTA + CD EXTRAÍDO A LA DERECHA)     -->
    <!-- ===================================================================== -->
    <section id="panel-3" class="story-panel">
      <div class="max-w-7xl mx-auto w-full px-4 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-start-8 lg:col-span-5 interactive-card panel-scroll-box mt-[42vh] lg:mt-0">
          <div class="bg-[#060C13]/95 border-2 border-[#10F57A] p-4 sm:p-5 shadow-[8px_8px_0px_#000000] space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
              <div>
                <span class="bg-[#00F0FF] text-black pixel-font text-[8px] px-2 py-0.5 border border-black font-bold">
                  CD-ROM EXTRAÍDO • GIRANDO
                </span>
                <h4 class="pixel-font text-xs text-[#10F57A] font-bold mt-1">MANUAL &amp; DISC 1: MARACAIBO</h4>
              </div>
              <span class="mono-font text-[11px] text-slate-400">P.01</span>
            </div>

            <!-- Controles compactos -->
            <div class="grid grid-cols-3 gap-1.5 text-[10px]">
              <div class="bg-black p-2 border border-slate-800 text-center">
                <kbd class="bg-[#FFD23F] text-black pixel-font text-[8px] px-1.5 py-0.5 border border-black font-bold block mb-1">WASD</kbd>
                <span class="text-slate-300 font-bold">CURSOR</span>
              </div>
              <div class="bg-black p-2 border border-slate-800 text-center">
                <kbd class="bg-[#00F0FF] text-black pixel-font text-[8px] px-1.5 py-0.5 border border-black font-bold block mb-1">TECLA U</kbd>
                <span class="text-slate-300 font-bold">ACCIÓN 1</span>
              </div>
              <div class="bg-black p-2 border border-slate-800 text-center">
                <kbd class="bg-[#FF2A55] text-white pixel-font text-[8px] px-1.5 py-0.5 border border-black font-bold block mb-1">TECLA I</kbd>
                <span class="text-slate-300 font-bold">ACCIÓN 2</span>
              </div>
            </div>
            <p class="mono-font text-[10px] text-slate-400 leading-snug">
              <span class="text-[#10F57A] font-bold">ENTER</span> = START. En <span class="text-[#00F0FF] font-bold">2P online</span> cada piloto usa su propio teclado.
            </p>

            <!-- Cómo se juega (mecánicas reales) -->
            <div class="bg-black/60 border border-slate-800 p-2.5 space-y-1.5">
              <div class="pixel-font text-[9px] text-[#FFD23F]">MECHA SIMULTACTICS</div>
              <ul class="mono-font text-[10px] text-slate-300 leading-snug space-y-1 list-none">
                <li><span class="text-[#00F0FF] font-bold">SIMULTÁNEO:</span> ambos eligen acción en secreto y resuelven a la vez.</li>
                <li><span class="text-[#00F0FF] font-bold">VELOCIDAD:</span> la acción más rápida golpea primero; si choca, clash.</li>
                <li><span class="text-[#00F0FF] font-bold">POSTURAS:</span> Normal→Aturdido→Retroceso→Derribado; encadena para rematar.</li>
                <li><span class="text-[#00F0FF] font-bold">GUTS:</span> se llena con parry, agarres y petróleo; gástalo en especiales.</li>
                <li><span class="text-[#00F0FF] font-bold">ZONAS:</span> rayo Catatumbo, verdín resbaladizo y petróleo explosivo.</li>
              </ul>
            </div>

            <!-- Top 5 High Scores compacto -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <span class="pixel-font text-[9px] text-[#FFD23F]">TOP 5 HIGH SCORES</span>
                <a href="https://erracode.pages.dev" target="_blank" rel="noopener noreferrer" class="mono-font text-[10px] text-[#00F0FF] hover:underline font-bold">
                  erracode.pages.dev ↗
                </a>
              </div>
              <ul class="space-y-1 pixel-font text-[9px]">
                <li class="flex justify-between bg-[#FFD23F]/15 border border-[#FFD23F]/50 px-2 py-1 text-[#FFD23F]">
                  <span>1. AAA</span><span>9190 PTS</span>
                </li>
                <li class="flex justify-between bg-black px-2 py-1 text-[#10F57A]">
                  <span>2. ZUL</span><span>8450 PTS</span>
                </li>
                <li class="flex justify-between bg-black px-2 py-1 text-slate-200">
                  <span>3. MAR</span><span>7820 PTS</span>
                </li>
                <li class="flex justify-between bg-black px-2 py-1 text-slate-400">
                  <span>4. TEM</span><span>6900 PTS</span>
                </li>
                <li class="flex justify-between bg-black px-2 py-1 text-slate-500">
                  <span>5. CPU</span><span>5120 PTS</span>
                </li>
              </ul>
            </div>

            <!-- Nota de origen -->
            <div class="p-2.5 bg-[#10F57A]/10 border-l-2 border-[#10F57A] text-[10px] text-slate-300 leading-snug">
              <strong class="text-[#10F57A]">ORIGEN:</strong> Nacido en <strong>Platanus Hack 26 — Arcade Challenge</strong> (&lt;50 KB) y expandido con <strong>Playroom Kit</strong> para duelos online 2P.
            </div>

            <!-- Botón lanzar disco -->
            <a
              href="/play?mode=cpu"
              class="btn-brutal w-full bg-[#10F57A] hover:bg-white text-black py-3 px-4 pixel-font text-[10px] sm:text-xs font-bold cursor-pointer block text-center"
            >
              SACAR DISCO / JUGAR (<span id="disc-mech-name">MBV-04</span>)
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- HUD INFERIOR DE PROGRESO + CONTROL MANUAL DE TAPA Y CD                -->
    <!-- ===================================================================== -->
    <div class="fixed bottom-3 left-3 right-3 z-40 pointer-events-none">
      <div class="max-w-4xl mx-auto bg-[#05070A]/95 border border-slate-700 px-3.5 py-2 flex flex-wrap items-center justify-between gap-2 shadow-[4px_4px_0px_#000000] pointer-events-auto">
        <div class="flex items-center gap-2.5">
          <span id="hud-stage-label" class="pixel-font text-[9px] sm:text-[10px] text-[#FFD23F]">
            01 / 04 • PORTADA
          </span>
          <div class="w-24 sm:w-36 h-2 bg-slate-800 border border-slate-600">
            <div id="scroll-progress-bar" class="h-full bg-gradient-to-r from-[#00F0FF] via-[#FFD23F] to-[#10F57A] w-0"></div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span class="mono-font text-[11px] text-slate-400 hidden sm:inline">Arrastra caja 360°</span>
          <button type="button" id="btn-manual-lid" class="btn-brutal bg-[#00F0FF] text-black pixel-font text-[9px] px-2.5 py-1 font-bold cursor-pointer">
            ABRIR / CERRAR TAPA
          </button>
        </div>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  :root {
    --space-black: #05070a;
    --saturn-yellow: #ffd23f;
    --holo-cyan: #00f0ff;
    --radar-green: #10f57a;
    --arcade-red: #ff2a55;
    --vo-pink: #e60067;
    --vo-mint: #5eead4;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
