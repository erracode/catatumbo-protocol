  // =========================================================================
  // 2. WARP-SPEED BACKGROUND (speed lines flying toward camera)
  //    ~750 instanced cylinders in a tilted group, behind the jewel case.
  // =========================================================================
  interface WarpLine {
    x: number;
    y: number;
    z: number;
    speed: number;
  }

  function createWarpField(scene: THREE.Scene) {
    const COUNT = 750;
    const palette = [0x00f0ff, 0xffd23f, 0xff2a55, 0x10f57a];
    const geo = new THREE.CylinderGeometry(0.008, 0.008, 1, 5, 1, true);
    // Cylinders point along Y by default; rotate so they lie along Z (depth).
    geo.rotateX(Math.PI / 2);

    const mat = new THREE.MeshBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.55,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      vertexColors: false,
    });

    const mesh = new THREE.InstancedMesh(geo, mat, COUNT);
    mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    mesh.frustumCulled = false;

    const group = new THREE.Group();
    group.rotation.set(0.25, 0.45, -0.65);
    group.position.set(0, 0, -18);
    group.add(mesh);
    scene.add(group);

    const lines: WarpLine[] = [];
    const dummy = new THREE.Object3D();
    const color = new THREE.Color();

    for (let i = 0; i < COUNT; i++) {
      // Radial distribution in a disc so lines form a tunnel.
      const angle = Math.random() * Math.PI * 2;
      const radius = 4 + Math.random() * 26;
      lines.push({
        x: Math.cos(angle) * radius,
        y: Math.sin(angle) * radius,
        z: -50 + Math.random() * 60,
        speed: 0.6 + Math.random() * 1.9,
      });
      mesh.setColorAt(i, color.setHex(palette[i % palette.length]));
    }
    mesh.instanceColor!.needsUpdate = true;

    let elapsed = 0;
    function update(dt: number) {
      elapsed += dt;
      for (let i = 0; i < COUNT; i++) {
        const l = lines[i];
        l.z += l.speed * dt * 60;
        if (l.z > 10) {
          l.z = -50;
          const angle = Math.random() * Math.PI * 2;
          const radius = 4 + Math.random() * 26;
          l.x = Math.cos(angle) * radius;
          l.y = Math.sin(angle) * radius;
        }
        // Stretch lines with speed for a streak feel.
        const len = 1.4 + l.speed * 1.6;
        dummy.position.set(l.x, l.y, l.z);
        dummy.scale.set(1, 1, len);
        dummy.updateMatrix();
        mesh.setMatrixAt(i, dummy.matrix);
      }
      mesh.instanceMatrix.needsUpdate = true;
      // Slow drift of the whole tunnel for life.
      group.rotation.z = -0.65 + Math.sin(elapsed * 0.12) * 0.04;
    }

    return { update };
  }

  // =========================================================================
  // 3. ESCENA THREE.JS + FIX DEFINITIVO DEL CD VISIBLEMENTE EXTRAÍDO
  // =========================================================================
  let scene: THREE.Scene;
  let camera: THREE.PerspectiveCamera;
  let renderer: THREE.WebGLRenderer;
  let jewelCaseGroup: THREE.Group;
  let frontLidGroup: THREE.Group;
  let discGroup: THREE.Group;
  let warp: { update: (dt: number) => void } | null = null;
  let manualLidOverride: boolean | null = null;
  let dragRotY = 0;
  let dragRotX = 0;
  let isDragging = false;
  let prevMouse = { x: 0, y: 0 };

  const currentPose = { posX: -1.75, posY: 0, posZ: 0, rotX: 0.12, rotY: 0.32, lidAngle: 0, discPop: 0, scale: 1 };
  const targetPose = { posX: -1.75, posY: 0, posZ: 0, rotX: 0.12, rotY: 0.32, lidAngle: 0, discPop: 0, scale: 1 };

  function initJewelCase3D() {
    const container = document.getElementById('three-stage');
    if (!container) return;

    scene = new THREE.Scene();

    const width = window.innerWidth;
    const height = window.innerHeight;
    camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
    camera.position.set(0, 0.08, width < 1024 ? 7.6 : 6.35);

    renderer = new THREE.WebGLRenderer({ alpha: true, antialias: false });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    container.appendChild(renderer.domElement);

    const ambient = new THREE.AmbientLight(0xffffff, 1.0);
    scene.add(ambient);
    const dirLight = new THREE.DirectionalLight(0x00f0ff, 0.7);
    dirLight.position.set(4, 6, 5);
    scene.add(dirLight);

    // Warp-speed background lines (behind the case, far in -Z).
    warp = createWarpField(scene);

    jewelCaseGroup = new THREE.Group();
    scene.add(jewelCaseGroup);

    const caseW = 3.1;
    const caseH = 2.8;
    const caseD = 0.28;

    const frontTex = createOfficialFrontCoverTexture();
    const spineTex = createObiSpineTexture();
    const backTex = createPixelBackCoverTexture();
    const discTex = createPrintedDiscTexture();
    const manualTex = createManualInsideTexture();

    // 1. Bandeja trasera negra (Z = -0.11 para dejar espacio holgado al CD)
    const trayMat = new THREE.MeshLambertMaterial({ color: 0x101620 });
    const backCoverMat = new THREE.MeshBasicMaterial({ map: backTex });
    const backMaterials = [trayMat, trayMat, trayMat, trayMat, trayMat, backCoverMat];
    const backBase = new THREE.Mesh(new THREE.BoxGeometry(caseW, caseH, 0.12), backMaterials);
    backBase.position.z = -0.11;
    jewelCaseGroup.add(backBase);

    // Soporte / spindle central elevado y perfectamente centrado en la bandeja
    const spindleGeo = new THREE.CylinderGeometry(0.22, 0.26, 0.11, 16);
    spindleGeo.rotateX(Math.PI / 2);
    const spindleMesh = new THREE.Mesh(spindleGeo, new THREE.MeshLambertMaterial({ color: 0x263244 }));
    spindleMesh.position.set(0, 0, -0.02);
    jewelCaseGroup.add(spindleMesh);

    // 2. Grupo del CD (centrado en X = 0, Y = 0 sobre su eje)
    discGroup = new THREE.Group();
    discGroup.position.set(0, 0, 0.02);
    jewelCaseGroup.add(discGroup);

    // RingGeometry plano con normales DoubleSide para cero z-fighting y máxima nitidez
    const ringGeo = new THREE.RingGeometry(0.24, 1.24, 36, 1);
    const uvAttr = ringGeo.attributes.uv;
    const posAttr = ringGeo.attributes.position;
    for (let i = 0; i < posAttr.count; i++) {
      const vx = posAttr.getX(i);
      const vy = posAttr.getY(i);
      uvAttr.setXY(i, vx / 2.48 + 0.5, vy / 2.48 + 0.5);
    }

    const discMat = new THREE.MeshBasicMaterial({ map: discTex, side: THREE.DoubleSide });
    const discMesh = new THREE.Mesh(ringGeo, discMat);
    discGroup.add(discMesh);

    // Aro acrílico central transparente del CD
    const clearHubGeo = new THREE.RingGeometry(0.14, 0.25, 24);
    const clearHubMat = new THREE.MeshBasicMaterial({
      color: 0xe2e8f0,
      transparent: true,
      opacity: 0.55,
      side: THREE.DoubleSide,
    });
    const clearHub = new THREE.Mesh(clearHubGeo, clearHubMat);
    discGroup.add(clearHub);

    // 3. Tapa frontal abatible (bisagra en el borde izquierdo X = -caseW/2)
    frontLidGroup = new THREE.Group();
    frontLidGroup.position.set(-caseW / 2, 0, 0.05);
    jewelCaseGroup.add(frontLidGroup);

    // Portada oficial exterior
    const coverPlane = new THREE.Mesh(
      new THREE.PlaneGeometry(caseW - 0.06, caseH - 0.06),
      new THREE.MeshBasicMaterial({ map: frontTex })
    );
    coverPlane.position.set(caseW / 2, 0, 0.045);
    frontLidGroup.add(coverPlane);

    // Interior de la tapa (Manual de operación)
    const manualPlane = new THREE.Mesh(
      new THREE.PlaneGeometry(caseW - 0.12, caseH - 0.12),
      new THREE.MeshBasicMaterial({ map: manualTex })
    );
    manualPlane.rotation.y = Math.PI;
    manualPlane.position.set(caseW / 2, 0, 0.03);
    frontLidGroup.add(manualPlane);

    // Cubierta acrílica translúcida frontal
    const plasticMat = new THREE.MeshPhongMaterial({
      color: 0xdbeafe,
      transparent: true,
      opacity: 0.18,
      shininess: 95,
    });
    const frontAcrylic = new THREE.Mesh(new THREE.BoxGeometry(caseW, caseH, 0.05), plasticMat);
    frontAcrylic.position.set(caseW / 2, 0, 0.07);
    frontLidGroup.add(frontAcrylic);

    // Lomo lateral izquierdo + Obi Strip japonés
    const spineMat = new THREE.MeshBasicMaterial({ map: spineTex });
    const spineMesh = new THREE.Mesh(new THREE.BoxGeometry(0.18, caseH, caseD), [
      trayMat,
      spineMat,
      trayMat,
      trayMat,
      trayMat,
      trayMat,
    ]);
    spineMesh.position.set(-0.02, 0, -0.06);
    frontLidGroup.add(spineMesh);

    // Aristas rectas cian sutiles
    const edges = new THREE.EdgesGeometry(new THREE.BoxGeometry(caseW, caseH, caseD));
    const line = new THREE.LineSegments(
      edges,
      new THREE.LineBasicMaterial({ color: 0x00f0ff, transparent: true, opacity: 0.3 })
    );
    jewelCaseGroup.add(line);

    // Rotación libre por arrastre con mouse o touch
    const onPointerDown = (clientX: number, clientY: number) => {
      isDragging = true;
      prevMouse = { x: clientX, y: clientY };
    };
    const onPointerMove = (clientX: number, clientY: number) => {
      if (!isDragging) return;
      dragRotY += (clientX - prevMouse.x) * 0.009;
      dragRotX = Math.max(-0.6, Math.min(0.6, dragRotX + (clientY - prevMouse.y) * 0.006));
      prevMouse = { x: clientX, y: clientY };
    };
    const onPointerUp = () => {
      isDragging = false;
    };

    container.addEventListener('mousedown', (e) => onPointerDown(e.clientX, e.clientY));
    window.addEventListener('mousemove', (e) => onPointerMove(e.clientX, e.clientY));
    window.addEventListener('mouseup', onPointerUp);

    container.addEventListener(
      'touchstart',
      (e) => {
        if (e.touches.length === 1) onPointerDown(e.touches[0].clientX, e.touches[0].clientY);
      },
      { passive: true }
    );
    window.addEventListener(
      'touchmove',
      (e) => {
        if (e.touches.length === 1) onPointerMove(e.touches[0].clientX, e.touches[0].clientY);
      },
      { passive: true }
    );
    window.addEventListener('touchend', onPointerUp);

    window.addEventListener('resize', () => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      camera.aspect = w / h;
      camera.position.z = w < 1024 ? 7.6 : 6.35;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      updateScrollStory();
    });
  }

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  // Timeline de 7 paradas. Cada keyframe = pose objetivo de la caja.
  // posX: lado opuesto a la tarjeta de copy (para no taparla en desktop).
  type Keyframe = {
    at: number;
    posX: number; posY: number; posZ: number;
    rotX: number; rotY: number;
    lidAngle: number; discPop: number; scale: number;
  };

  const desktopFrames: Keyframe[] = [
    { at: 0.0,  posX: 0.9,  posY: 0.0,  posZ: 0.0,  rotX: 0.1,  rotY: 0.32,      lidAngle: 0,     discPop: 0, scale: 1.0  },
    { at: 0.16, posX: 1.5,  posY: 0.0,  posZ: 0.15, rotX: 0.04, rotY: 1.52,      lidAngle: 0,     discPop: 0, scale: 1.0  },
    { at: 0.32, posX: -1.5, posY: 0.0,  posZ: 0.1,  rotX: 0.08, rotY: Math.PI,   lidAngle: 0,     discPop: 0, scale: 1.0  },
    { at: 0.48, posX: 0.9,  posY: 0.0,  posZ: -1.0, rotX: 0.06, rotY: Math.PI*2, lidAngle: -2.15, discPop: 1, scale: 0.9  },
    { at: 0.64, posX: -0.9, posY: 0.0,  posZ: -1.0, rotX: 0.06, rotY: Math.PI*2, lidAngle: -2.15, discPop: 1, scale: 0.9  },
    { at: 0.80, posX: 0.9,  posY: 0.0,  posZ: -0.6, rotX: 0.06, rotY: Math.PI*2, lidAngle: -2.15, discPop: 1, scale: 0.95 },
    { at: 1.0,  posX: -0.9, posY: 0.0,  posZ: -0.6, rotX: 0.06, rotY: Math.PI*2, lidAngle: -2.15, discPop: 1, scale: 0.95 },
  ];

  const mobileFrames: Keyframe[] = [
    { at: 0.0,  posX: 0, posY: 0.9,  posZ: 0.0,  rotX: 0.1,  rotY: 0.32,      lidAngle: 0,     discPop: 0, scale: 0.72 },
    { at: 0.16, posX: 0, posY: 0.9,  posZ: 0.1,  rotX: 0.04, rotY: 1.52,      lidAngle: 0,     discPop: 0, scale: 0.72 },
    { at: 0.32, posX: 0, posY: 0.9,  posZ: 0.1,  rotX: 0.08, rotY: Math.PI,   lidAngle: 0,     discPop: 0, scale: 0.72 },
    { at: 0.48, posX: 0, posY: 0.95, posZ: -0.8, rotX: 0.06, rotY: Math.PI*2, lidAngle: -2.15, discPop: 1, scale: 0.66 },
    { at: 0.64, posX: 0, posY: 0.95, posZ: -0.8, rotX: 0.06, rotY: Math.PI*2, lidAngle: -2.15, discPop: 1, scale: 0.66 },
    { at: 0.80, posX: 0, posY: 0.95, posZ: -0.5, rotX: 0.06, rotY: Math.PI*2, lidAngle: -2.15, discPop: 1, scale: 0.7  },
    { at: 1.0,  posX: 0, posY: 0.95, posZ: -0.5, rotX: 0.06, rotY: Math.PI*2, lidAngle: -2.15, discPop: 1, scale: 0.7  },
  ];

  const STAGE_NAMES = [
    '01 / 07 • PORTADA',
    '02 / 07 • LOMO & MECHAS',
    '03 / 07 • CONTRAPORTADA',
    '04 / 07 • ORIGEN',
    '05 / 07 • CÓMO SE HIZO',
    '06 / 07 • MÚSICA',
    '07 / 07 • GAMEPLAY',
  ];

  function updateScrollStory() {
    const track = document.getElementById('scroll-track');
    if (!track) return;

    const docEl = document.documentElement;
    const scrollTop = window.pageYOffset || docEl.scrollTop || document.body.scrollTop || 0;
    const maxScroll = Math.max(1, docEl.scrollHeight - window.innerHeight);
    const progress = Math.max(0, Math.min(1, scrollTop / maxScroll));

    const bar = document.getElementById('scroll-progress-bar');
    if (bar) bar.style.width = `${(progress * 100).toFixed(1)}%`;

    if (!isDragging) {
      dragRotY *= 0.85;
      dragRotX *= 0.85;
    }

    const isDesktop = window.innerWidth >= 1024;
    const frames = isDesktop ? desktopFrames : mobileFrames;

    // Segmento [i, i+1] que contiene a progress; lerp de pose entre keyframes.
    let seg = 0;
    for (let i = 0; i < frames.length - 1; i++) {
      if (progress >= frames[i].at && progress <= frames[i + 1].at) { seg = i; break; }
      if (progress > frames[frames.length - 1].at) seg = frames.length - 2;
    }
    const a = frames[seg];
    const b = frames[seg + 1];
    const span = Math.max(1e-6, b.at - a.at);
    const t = Math.max(0, Math.min(1, (progress - a.at) / span));

    targetPose.posX = lerp(a.posX, b.posX, t);
    targetPose.posY = lerp(a.posY, b.posY, t);
    targetPose.posZ = lerp(a.posZ, b.posZ, t);
    targetPose.rotX = lerp(a.rotX, b.rotX, t);
    targetPose.rotY = lerp(a.rotY, b.rotY, t);
    targetPose.lidAngle = lerp(a.lidAngle, b.lidAngle, t);
    targetPose.discPop = lerp(a.discPop, b.discPop, t);
    targetPose.scale = lerp(a.scale, b.scale, t);

    // Parada activa = keyframe más cercano.
    let activeStop = 0;
    let bestDist = Infinity;
    for (let i = 0; i < frames.length; i++) {
      const d = Math.abs(progress - frames[i].at);
      if (d < bestDist) { bestDist = d; activeStop = i; }
    }

    // Overlays de zona: solo el activo visible.
    const zones = document.querySelectorAll<HTMLElement>('.zone-copy');
    zones.forEach((el) => {
      el.classList.toggle('is-active', Number(el.dataset.stop) === activeStop);
    });

    const hudLabel = document.getElementById('hud-stage-label');
    if (hudLabel) hudLabel.textContent = STAGE_NAMES[activeStop];

    // BGM runs its own auto-cycle (title vamp <-> combat), enabled once at boot;
    // scrolling must not override it.

    const effectiveLid = manualLidOverride !== null ? (manualLidOverride ? -2.15 : 0) : targetPose.lidAngle;
    const btnLid = document.getElementById('btn-manual-lid');
    if (btnLid) {
      btnLid.textContent = effectiveLid < -0.5 ? 'CERRAR TAPA' : 'ABRIR / CERRAR TAPA';
    }
  }

  function toggleManualLid() {
    const currentOpen = manualLidOverride !== null ? manualLidOverride : targetPose.lidAngle < -0.5;
    manualLidOverride = !currentOpen;
    updateScrollStory();
  }

  let lastFrame = performance.now();
  const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  function animate3D() {
    requestAnimationFrame(animate3D);
    if (!jewelCaseGroup) return;

    const now = performance.now();
    const dt = Math.min(0.05, (now - lastFrame) / 1000);
    lastFrame = now;

    const reduceMotion = reduceMotionQuery.matches;
    // With reduced motion, snap to targets instead of easing, and skip the idle bob.
    const ease = reduceMotion ? 1 : 0.12;

    // Lee continuamente el progreso del scroll en cada frame
    updateScrollStory();

    currentPose.posX += (targetPose.posX - currentPose.posX) * ease;
    currentPose.posY += (targetPose.posY - currentPose.posY) * ease;
    currentPose.posZ += (targetPose.posZ - currentPose.posZ) * ease;
    currentPose.rotY += (targetPose.rotY - currentPose.rotY) * ease;
    currentPose.rotX += (targetPose.rotX - currentPose.rotX) * ease;

    const desiredLid = manualLidOverride !== null ? (manualLidOverride ? -2.15 : 0) : targetPose.lidAngle;
    const desiredPop = manualLidOverride !== null ? (manualLidOverride ? 1 : 0) : targetPose.discPop;

    currentPose.lidAngle += (desiredLid - currentPose.lidAngle) * ease;
    currentPose.discPop += (desiredPop - currentPose.discPop) * ease;

    // Si el usuario abre la tapa manualmente en cualquier parada, ajusta el encuadre
    const manualZoomOffset = manualLidOverride ? -1.1 : 0;
    const manualShiftX = manualLidOverride && window.innerWidth >= 1024 && currentPose.posX < -1.2 ? 0.95 : 0;

    jewelCaseGroup.scale.setScalar(currentPose.scale);
    jewelCaseGroup.position.set(
      currentPose.posX + manualShiftX,
      currentPose.posY + (reduceMotion ? 0 : Math.sin(Date.now() * 0.0025) * 0.04),
      currentPose.posZ + manualZoomOffset
    );
    jewelCaseGroup.rotation.y = currentPose.rotY + dragRotY;
    jewelCaseGroup.rotation.x = currentPose.rotX + dragRotX;

    frontLidGroup.rotation.y = currentPose.lidAngle;

    if (discGroup) {
      discGroup.position.x = 0;
      discGroup.position.y = 0;
      discGroup.position.z = 0.02 + currentPose.discPop * 0.22;
      if (currentPose.lidAngle < -0.35) {
        discGroup.rotation.z -= 0.014;
      }
    }

    if (warp) warp.update(dt);

    renderer.render(scene, camera);
  }

  // =========================================================================
