  }
  @media (hover: hover) and (pointer: fine) {
    .mech-card:not(.active):hover {
      border-color: #475569;
      transform: translateX(2px);
    }
  }
  .mech-card.active {
    border: 2px solid #00f0ff;
    background: #0b1928;
    box-shadow: 4px 4px 0px #000000;
  }
  .mech-card:focus-visible {
    outline: 2px solid #00f0ff;
    outline-offset: 2px;
  }

  /* Nav stop buttons */
  .nav-stop {
    font-family: 'Geist Pixel', 'Silkscreen', monospace;
    letter-spacing: 0.03em;
    font-size: 9px;
    padding: 0.25rem 0.625rem;
    border: 1px solid #334155;
    background: #0f172a;
    color: #e2e8f0;
    cursor: pointer;
    transition:
      background-color 0.15s var(--ease-out),
      color 0.15s var(--ease-out),
      border-color 0.15s var(--ease-out);
  }
  @media (min-width: 640px) {
    .nav-stop {
      font-size: 10px;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-stop:not(.nav-stop-active):hover {
      color: #00f0ff;
      border-color: #00f0ff;
    }
  }
  .nav-stop-active {
    background: #ffd23f;
    color: #000000;
    border-color: #000000;
    font-weight: 700;
  }

  @keyframes blinkInsert {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0.25;
    }
  }
  .blink-coin {
    animation: blinkInsert 1.1s infinite;
  }

  /* Escenario 3D fijo a pantalla completa */
  #three-stage {
    position: fixed;
    inset: 0;
    z-index: 10;
    cursor: grab;
  }
  #three-stage:active {
    cursor: grabbing;
  }
  /* Warp-speed glow behind the jewel case, above the starfield CSS layer */
  #three-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 50% 50%, rgba(0, 240, 255, 0.1) 0%, transparent 60%),
      radial-gradient(40% 40% at 50% 50%, rgba(255, 210, 63, 0.05) 0%, transparent 70%);
  }

  /* Pista de Scrollytelling de 420vh */
  #scroll-track {
    position: relative;
    height: 420vh;
    z-index: 20;
    pointer-events: none;
  }

  /* Paneles flotantes sincronizados */
  .story-panel {
    position: fixed;
    inset: 0;
    padding-top: 56px;
    padding-bottom: 52px;
    display: flex;
    align-items: flex-end;
    pointer-events: none;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.28s var(--ease-out),
      transform 0.28s var(--ease-out);
    z-index: 25;
  }

  @media (min-width: 1024px) {
    .story-panel {
      align-items: center;
    }
  }

  .story-panel.active {
    opacity: 1;
    transform: translateY(0);
  }

  .story-panel.active .interactive-card {
    pointer-events: auto;
  }

  .panel-scroll-box {
    max-height: 46vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #00f0ff #05070a;
  }

  @media (min-width: 1024px) {
    .panel-scroll-box {
      max-height: calc(100vh - 122px);
    }
  }

  /* Skip-link target: scroll-margin keeps the fixed nav from covering it. */
  #content {
    scroll-margin-top: 64px;
  }

  /* Accessible focus ring for icon/knob buttons that rely on the global ring. */
  .nav-stop:focus-visible,
  #btn-manual-lid:focus-visible {
    outline: 2px solid #00f0ff;
    outline-offset: 2px;
  }

  /* Marquee ticker strip (top of landing). GPU-only transform; pauses on hover. */
  .ticker {
    overflow: hidden;
    white-space: nowrap;
  }
  .ticker__track {
    display: inline-block;
    padding-left: 100%;
    animation: ticker 28s linear infinite;
    will-change: transform;
  }
  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }
  @media (hover: hover) and (pointer: fine) {
    .ticker:hover .ticker__track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .blink-coin {
      animation: none;
    }
    .story-panel {
      transition-duration: 0.01ms;
    }
    .btn-brutal,
    .mech-card,
    .nav-stop {
      transition-duration: 0.01ms;
    }
    /* Stop the infinite ticker; keep it readable as a static line. */
    .ticker__track {
      animation: none;
      padding-left: 0;
    }
  }
</style>

<script>
  import * as THREE from 'three';

  // =========================================================================
  // 1. PINTURA PROCEDURAL DE LA CARÁTULA OFICIAL (PORTADA + SUPERFICIE DEL CD)
  // =========================================================================
  function paintOfficialCoverArt(ctx: CanvasRenderingContext2D, size: number) {
    ctx.imageSmoothingEnabled = false;
    const s = size / 512;

    // Fondo nocturno del Lago de Maracaibo
    ctx.fillStyle = '#071117';
    ctx.fillRect(0, 0, size, size);

    // Grilla isométrica verde
    ctx.strokeStyle = 'rgba(16, 245, 122, 0.18)';
    ctx.lineWidth = Math.max(1, 1.5 * s);
    for (let i = -size; i < size * 2; i += 34 * s) {
      ctx.beginPath();
      ctx.moveTo(i, 0);
      ctx.lineTo(i + size * 0.85, size * 0.5);
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(i + size * 0.85, 0);
      ctx.lineTo(i, size * 0.5);
      ctx.stroke();
    }

    // Costa verde isométrica
    ctx.fillStyle = '#152A22';
    ctx.beginPath();
    ctx.moveTo(0, 140 * s);
    ctx.lineTo(270 * s, 290 * s);
    ctx.lineTo(130 * s, 370 * s);
    ctx.lineTo(240 * s, 440 * s);
    ctx.lineTo(0, 512 * s);
    ctx.closePath();
    ctx.fill();

    ctx.beginPath();
    ctx.moveTo(290 * s, 0);
    ctx.lineTo(512 * s, 0);
    ctx.lineTo(512 * s, 210 * s);
    ctx.lineTo(395 * s, 145 * s);
    ctx.closePath();
    ctx.fill();

    // Agua azul turquesa del Lago
    ctx.fillStyle = '#0A516D';
    ctx.beginPath();
    ctx.moveTo(290 * s, 0);
    ctx.lineTo(395 * s, 145 * s);
    ctx.lineTo(512 * s, 210 * s);
    ctx.lineTo(512 * s, 512 * s);
    ctx.lineTo(240 * s, 440 * s);
    ctx.lineTo(130 * s, 370 * s);
    ctx.lineTo(270 * s, 290 * s);
    ctx.lineTo(0, 140 * s);
    ctx.lineTo(0, 0);
    ctx.closePath();
    ctx.fill();

    // Orilla arena
    ctx.strokeStyle = '#C2B280';
    ctx.lineWidth = 4 * s;
    ctx.beginPath();
    ctx.moveTo(0, 140 * s);
    ctx.lineTo(270 * s, 290 * s);
    ctx.lineTo(130 * s, 370 * s);
    ctx.lineTo(240 * s, 440 * s);
    ctx.stroke();

    // Puente Rafael Urdaneta
    ctx.strokeStyle = '#94A3B8';
    ctx.lineWidth = 14 * s;
    ctx.beginPath();
    ctx.moveTo(220 * s, 260 * s);
    ctx.lineTo(375 * s, 175 * s);
    ctx.stroke();

    [255, 315, 360].forEach((px, idx) => {
      const py = 240 - idx * 32;
      ctx.fillStyle = '#CBD5E1';
      ctx.fillRect((px - 4) * s, (py - 55) * s, 8 * s, 65 * s);
      ctx.strokeStyle = '#E2E8F0';
      ctx.lineWidth = 1.5 * s;
      ctx.beginPath();
      ctx.moveTo(px * s, (py - 52) * s);
      ctx.lineTo((px - 32) * s, (py + 12) * s);
      ctx.moveTo(px * s, (py - 52) * s);
      ctx.lineTo((px + 32) * s, (py + 12) * s);
      ctx.stroke();
    });

    // Palafitos
    const drawPalafito = (px: number, py: number) => {
      ctx.fillStyle = '#78350F';
      ctx.fillRect(px * s, py * s, 18 * s, 14 * s);
      ctx.fillStyle = '#92400E';
      ctx.beginPath();
      ctx.moveTo((px - 3) * s, py * s);
      ctx.lineTo((px + 9) * s, (py - 12) * s);
      ctx.lineTo((px + 21) * s, py * s);
      ctx.closePath();
      ctx.fill();
    };
    drawPalafito(160, 325);
    drawPalafito(182, 336);

    // Relámpagos amarillos del Catatumbo
    const drawLightning = (points: number[][]) => {
      ctx.strokeStyle = '#F59E0B';
      ctx.lineWidth = 8 * s;
      ctx.beginPath();
      points.forEach(([x, y], i) => (i === 0 ? ctx.moveTo(x * s, y * s) : ctx.lineTo(x * s, y * s)));
      ctx.stroke();

      ctx.strokeStyle = '#FEF08A';
      ctx.lineWidth = 3.5 * s;
      ctx.beginPath();
      points.forEach(([x, y], i) => (i === 0 ? ctx.moveTo(x * s, y * s) : ctx.lineTo(x * s, y * s)));
      ctx.stroke();
    };
    drawLightning([[115, 0], [102, 75], [116, 130], [106, 185]]);
    drawLightning([[148, 0], [136, 95], [148, 150], [134, 240]]);
    drawLightning([[245, 0], [232, 85], [248, 135], [228, 200]]);
    drawLightning([[315, 0], [302, 110], [316, 175], [295, 285]]);
    drawLightning([[402, 0], [392, 70], [406, 115], [390, 170]]);

    // 4 Mechas con sables láser cian
    const drawMecha = (
      x: number,
      y: number,
      scale: number,
      bodyColor: string,
      trimColor: string,
      saberUp = true
    ) => {
      ctx.save();
      ctx.translate(x * s, y * s);
      ctx.scale(scale * s, scale * s);

      ctx.fillStyle = '#D6D3C9';
      ctx.fillRect(-16, 18, 12, 28);
      ctx.fillRect(4, 18, 12, 28);

      ctx.fillStyle = bodyColor;
      ctx.fillRect(-19, 42, 16, 10);
      ctx.fillRect(3, 42, 16, 10);

      ctx.fillStyle = bodyColor;
      ctx.fillRect(-18, -14, 36, 32);

      ctx.fillStyle = trimColor;
      ctx.fillRect(-27, -14, 10, 16);
      ctx.fillRect(17, -14, 10, 16);

      ctx.fillStyle = '#E7E5E4';
      ctx.fillRect(-10, -30, 20, 16);
      ctx.fillRect(-8, -38, 4, 8);
      ctx.fillRect(4, -38, 4, 8);
      ctx.fillStyle = '#00F0FF';
      ctx.fillRect(-7, -25, 14, 5);

      ctx.fillStyle = '#00F0FF';
      if (saberUp) {
        ctx.fillRect(-28, -72, 6, 56);
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(-26, -70, 2, 52);
      } else {
        ctx.fillRect(-44, 6, 36, 5);
      }
      ctx.restore();
    };

    drawMecha(98, 225, 1.35, '#DC2626', '#EA580C', false);
    drawMecha(415, 118, 0.72, '#16A34A', '#EA580C', true);
    drawMecha(392, 192, 0.7, '#7E22CE', '#3B82F6', true);
    drawMecha(412, 345, 2.35, '#1D4ED8', '#EA580C', true);

    // Caja superior izquierda: PLATANUS HACK 26 / VE // CARACAS (tachado) MARACAIBO
    ctx.fillStyle = 'rgba(5, 7, 10, 0.9)';
    ctx.fillRect(10 * s, 10 * s, 156 * s, 54 * s);
    ctx.strokeStyle = '#FFD23F';
    ctx.lineWidth = 2 * s;
    ctx.strokeRect(10 * s, 10 * s, 156 * s, 54 * s);

    ctx.fillStyle = '#FFD23F';
    ctx.font = `bold ${Math.round(10 * s)}px monospace`;
    ctx.fillText('PLATANUS HACK 26', 18 * s, 27 * s);

    ctx.fillStyle = '#FFFFFF';
    ctx.fillText('VE // CARACAS', 18 * s, 45 * s);
    ctx.strokeStyle = '#FF2A55';
    ctx.lineWidth = 2.5 * s;
    ctx.beginPath();
    ctx.moveTo(50 * s, 41 * s);
    ctx.lineTo(102 * s, 41 * s);
    ctx.stroke();

    ctx.save();
    ctx.translate(106 * s, 49 * s);
    ctx.rotate(-0.12);
    ctx.fillStyle = '#FF2A55';
    ctx.font = `bold italic ${Math.round(11 * s)}px sans-serif`;
    ctx.fillText('MARACAIBO', 0, 0);
    ctx.restore();

    // Marca superior derecha: ERRACODE
    ctx.fillStyle = '#CBD5E1';
    ctx.font = `bold ${Math.round(10 * s)}px monospace`;
    ctx.fillText('ERRACODE', 442 * s, 22 * s);

    // Título principal inferior: CATATUMBO PROTOCOL
    ctx.save();
    ctx.font = `900 italic ${Math.round(52 * s)}px sans-serif`;
    ctx.textAlign = 'center';
    ctx.fillStyle = '#000000';
    ctx.fillText('CATATUMBO', 260 * s, 444 * s);
    ctx.fillStyle = '#FF2A55';
    ctx.fillText('CATATUMBO', 257 * s, 441 * s);
    ctx.fillStyle = '#FFD23F';
    ctx.fillText('CATATUMBO', 255 * s, 438 * s);

    ctx.font = `900 italic ${Math.round(31 * s)}px sans-serif`;
    ctx.fillStyle = '#000000';
    ctx.fillText('PROTOCOL', 258 * s, 479 * s);
    ctx.fillStyle = '#00F0FF';
    ctx.fillText('PROTOCOL', 256 * s, 477 * s);
    ctx.restore();
  }

  function makeTex(canvas: HTMLCanvasElement) {
    const tex = new THREE.CanvasTexture(canvas);
    tex.magFilter = THREE.NearestFilter;
    tex.minFilter = THREE.NearestFilter;
    return tex;
  }

  function createOfficialFrontCoverTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 512;
    paintOfficialCoverArt(canvas.getContext('2d') as CanvasRenderingContext2D, 512);
    return makeTex(canvas);
  }

  // Textura circular para RingGeometry del CD con brillo iridiscente y etiqueta
  function createPrintedDiscTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 512;
    const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;

    paintOfficialCoverArt(ctx, 512);

    // Brillo holográfico / iridiscente encima de la impresión
    const grad = ctx.createLinearGradient(0, 0, 512, 512);
    grad.addColorStop(0, 'rgba(0, 240, 255, 0.24)');
    grad.addColorStop(0.35, 'rgba(255, 255, 255, 0.08)');
    grad.addColorStop(0.7, 'rgba(255, 210, 63, 0.20)');
    grad.addColorStop(1, 'rgba(230, 0, 103, 0.26)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 512, 512);

    // Borde exterior plateado del CD
    ctx.strokeStyle = '#F8FAFC';
    ctx.lineWidth = 10;
    ctx.beginPath();
    ctx.arc(256, 256, 250, 0, Math.PI * 2);
    ctx.stroke();

    // Aro acrílico central del disco
    ctx.strokeStyle = '#CBD5E1';
    ctx.lineWidth = 14;
    ctx.beginPath();
    ctx.arc(256, 256, 58, 0, Math.PI * 2);
    ctx.stroke();

    return makeTex(canvas);
  }

  // Obi Strip japonés + lomo estilo SEGA Saturn / PS1
  function createObiSpineTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 96;
    canvas.height = 512;
    const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
    ctx.imageSmoothingEnabled = false;

    // Mitad izquierda: lomo negro con borde cian
    ctx.fillStyle = '#070B12';
    ctx.fillRect(0, 0, 48, 512);
    ctx.strokeStyle = '#00F0FF';
    ctx.lineWidth = 3;
    ctx.strokeRect(2, 2, 44, 508);

    // Mitad derecha: Obi Strip japonés amarillo/rojo estilo SEGA Saturn
    ctx.fillStyle = '#FFD23F';
    ctx.fillRect(48, 0, 48, 512);
    ctx.fillStyle = '#E60067';
    ctx.fillRect(48, 0, 48, 64);
    ctx.fillStyle = '#000000';
    ctx.fillRect(48, 430, 48, 82);

    ctx.save();
    ctx.translate(31, 480);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = '#FFFFFF';
    ctx.font = 'bold 20px monospace';
    ctx.fillText('CATATUMBO PROTOCOL', 0, 0);
    ctx.fillStyle = '#00F0FF';
    ctx.font = 'bold 16px monospace';
    ctx.fillText('SLUS-1996-MCBO', 290, 0);
    ctx.restore();

    ctx.save();
    ctx.translate(78, 415);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = '#000000';
    ctx.font = 'bold 18px monospace';
    ctx.fillText('電脳戦機 • 1996 ARCHIVE', 0, 0);
    ctx.restore();

    ctx.fillStyle = '#FFFFFF';
    ctx.font = 'bold 13px monospace';
    ctx.fillText('SEGA', 55, 38);
    ctx.fillStyle = '#10F57A';
    ctx.font = 'bold 11px monospace';
    ctx.fillText('NTSC', 56, 465);
    ctx.fillText('1996', 56, 485);

    return makeTex(canvas);
  }

  function createPixelBackCoverTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
    ctx.imageSmoothingEnabled = false;

    ctx.fillStyle = '#05070A';
    ctx.fillRect(0, 0, 256, 256);

    ctx.fillStyle = '#FFD23F';
    ctx.fillRect(14, 14, 228, 205);

    ctx.fillStyle = '#000000';
    ctx.font = 'bold italic 16px sans-serif';
    ctx.fillText('CATATUMBO PROTOCOL', 24, 36);

    ctx.fillStyle = '#E11D48';
    ctx.fillRect(24, 46, 98, 62);
    ctx.fillStyle = '#07222B';
    ctx.fillRect(28, 50, 90, 54);

    ctx.fillStyle = '#E11D48';
    ctx.fillRect(132, 114, 98, 62);
    ctx.fillStyle = '#07222B';
    ctx.fillRect(136, 118, 90, 54);

    ctx.fillStyle = '#111827';
    for (let i = 0; i < 6; i++) {
      ctx.fillRect(132, 50 + i * 9, 95, 4);
      ctx.fillRect(24, 118 + i * 9, 95, 4);
    }

    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(20, 225, 65, 22);
    ctx.fillStyle = '#000000';
    for (let b = 24; b < 80; b += 4) {
      ctx.fillRect(b, 228, 2, 16);
    }

    ctx.fillStyle = '#00F0FF';
    ctx.font = 'bold 11px monospace';
    ctx.fillText('SEGA / PSX 1996', 135, 240);

    return makeTex(canvas);
