        <rect x="44" y="14" width="32" height="16"/>
        <rect x="48" y="20" width="24" height="5" class="fill-[#00F0FF]/40"/>
        <rect x="30" y="32" width="60" height="38"/>
        <rect x="12" y="26" width="18" height="30"/>
        <rect x="90" y="26" width="18" height="30"/>
        <rect x="16" y="56" width="12" height="34" class="stroke-[#FFD23F]"/>
        <rect x="92" y="56" width="12" height="34" class="stroke-[#FFD23F]"/>
        <rect x="36" y="72" width="18" height="34"/>
        <rect x="66" y="72" width="18" height="34"/>
        <rect x="32" y="106" width="24" height="8"/>
        <rect x="64" y="106" width="24" height="8"/>
      </svg>`,
    },
  ];
  let selectedMechIndex = 0;

  function selectVirtualoid(index: number) {
    selectedMechIndex = index;
    const mech = virtualoids[index];

    virtualoids.forEach((_, idx) => {
      const card = document.getElementById(`mech-card-${idx}`);
      if (card) card.classList.toggle('active', idx === index);
    });

    document.getElementById('selected-mech-badge')!.textContent = mech.fullName;
    document.getElementById('disc-mech-name')!.textContent = mech.code;
    document.getElementById('mech-blueprint-svg')!.innerHTML = mech.svg;
    document.getElementById('bp-code')!.textContent = mech.code;
    document.getElementById('bp-name')!.textContent = mech.shortName;
    document.getElementById('bp-weapons')!.innerHTML = mech.weapons;
    document.getElementById('bp-stats')!.textContent = mech.stats;
    document.getElementById('bp-sector')!.textContent = mech.sector;
  }

  // =========================================================================
  // 5. 4 CAPTURAS PIXEL ART PARA LA CONTRAPORTADA AMARILLA
  // =========================================================================
  function drawIsometricBoard(ctx: CanvasRenderingContext2D, w: number, h: number, variant: number) {
    ctx.imageSmoothingEnabled = false;
    ctx.fillStyle = '#051014';
    ctx.fillRect(0, 0, w, h);

    ctx.strokeStyle = 'rgba(16, 245, 122, 0.18)';
    ctx.lineWidth = 1;
    for (let x = 0; x < w; x += 16) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }
    for (let y = 0; y < h; y += 16) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    // Tablero isométrico del Lago
    ctx.fillStyle = '#0B4358';
    ctx.beginPath();
    ctx.moveTo(w / 2, 20);
    ctx.lineTo(w - 22, h / 2 + 8);
    ctx.lineTo(w / 2, h - 12);
    ctx.lineTo(22, h / 2 + 8);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = '#C2B280';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Puente Rafael Urdaneta
    ctx.strokeStyle = '#94A3B8';
    ctx.lineWidth = 5;
    ctx.beginPath();
    ctx.moveTo(75, 65);
    ctx.lineTo(175, 40);
    ctx.stroke();

    const p1x = variant === 4 ? 148 : 115;
    const p1y = variant === 4 ? 76 : 85;
    ctx.fillStyle = '#1D4ED8';
    ctx.fillRect(p1x, p1y, 12, 16);
    ctx.fillStyle = '#FFD23F';
    ctx.fillRect(p1x - 2, p1y + 2, 16, 4);

    const p2x = variant === 4 ? 168 : 205;
    const p2y = variant === 4 ? 70 : 58;
    ctx.fillStyle = '#DC2626';
    ctx.fillRect(p2x, p2y, 12, 16);
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(p2x + 2, p2y - 3, 8, 4);

    if (variant === 1) {
      // Duelo isométrico en el Lago
      ctx.strokeStyle = '#00F0FF';
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      ctx.moveTo(p1x + 6, p1y + 8);
      ctx.lineTo(p1x + 52, p1y - 14);
      ctx.stroke();
      ctx.setLineDash([]);
    } else if (variant === 2) {
      // Impacto de relámpago en el Puente
      ctx.strokeStyle = '#FFD23F';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(145, 6);
      ctx.lineTo(132, 34);
      ctx.lineTo(146, 40);
      ctx.lineTo(130, 56);
      ctx.stroke();
    } else if (variant === 3) {
      // Emboscada en Palafitos
      ctx.fillStyle = '#92400E';
      ctx.fillRect(62, 92, 16, 12);
      ctx.fillRect(82, 98, 16, 12);
      ctx.fillStyle = '#10F57A';
      ctx.fillRect(102, 94, 5, 5);
      ctx.fillRect(116, 88, 5, 5);
    } else if (variant === 4) {
      // Choque de sables láser
      ctx.strokeStyle = '#00F0FF';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(p1x + 12, p1y + 4);
      ctx.lineTo(p2x, p2y + 4);
      ctx.stroke();

      ctx.fillStyle = '#FFD23F';
      ctx.fillRect(p1x + 13, p2y + 1, 6, 6);
    }
  }

  function renderBackCoverScreenshots() {
    [1, 2, 3, 4].forEach((num) => {
      const c = document.getElementById(`shot-${num}`) as HTMLCanvasElement | null;
      if (c) drawIsometricBoard(c.getContext('2d') as CanvasRenderingContext2D, c.width, c.height, num);
    });
  }

  // =========================================================================
  // 6. WIRING
  // =========================================================================
  function wireInteractions() {
    document.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((btn) => {
      btn.addEventListener('click', () => scrollToStop(Number(btn.dataset.stop)));
    });

    document.querySelectorAll<HTMLButtonElement>('[data-mech]').forEach((btn) => {
      btn.addEventListener('click', () => selectVirtualoid(Number(btn.dataset.mech)));
    });

    document.getElementById('btn-manual-lid')?.addEventListener('click', toggleManualLid);

    window.addEventListener('scroll', updateScrollStory, { passive: true });
  }

  function boot() {
    initJewelCase3D();
    animate3D();
    selectVirtualoid(0);
    renderBackCoverScreenshots();
    updateScrollStory();
    wireInteractions();
  }

  if (document.readyState === 'complete') {
    boot();
  } else {
    window.addEventListener('load', boot);
  }
</script>
