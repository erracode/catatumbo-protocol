---
import Base from '../layouts/Base.astro';
---
<Base title="Catatumbo Protocol — Mecha Duel">
  <main class="landing">
    <section class="hero">
      <img class="cover" src="/cover.png" alt="Catatumbo Protocol cover art" width="400" height="300" />
      <div class="hero-text">
        <h1>Catatumbo Protocol</h1>
        <p class="tagline">
          A simultaneous-turn mecha duel over Lake Maracaibo.
          Both pilots commit their moves in secret, then watch the clash unfold.
        </p>
        <div class="cta">
          <a class="btn primary" href="/play">Play vs CPU</a>
          <a class="btn" href="/play?mode=net">Play Online (2P)</a>
        </div>
      </div>
    </section>

    <section class="info">
      <div class="card">
        <h2>How it plays</h2>
        <ul>
          <li>Pick your action each turn — movement, strike, or special.</li>
          <li>Your rival does the same, blind to your choice.</li>
          <li>Both plans resolve at once: clashes, grabs, and zone hazards.</li>
          <li>Chain stances — staggered, knockback, down — to land finishers.</li>
        </ul>
      </div>
      <div class="card">
        <h2>Controls</h2>
        <ul>
          <li><b>P1:</b> W/A/S/D to move, U/I/O/J/K/L to act.</li>
          <li><b>P2 (online):</b> your own keyboard.</li>
          <li>START to begin.</li>
        </ul>
      </div>
    </section>

    <footer class="credits">
      <p>
        Originally built for the <b>Platanus Hack 26 — Arcade Challenge</b> (Caracas).
        Now running standalone with online multiplayer via Playroom Kit.
      </p>
      <p class="muted">Mecha duel · Simultaneous turns · Lake Maracaibo</p>
    </footer>
  </main>
</Base>

<style>
  .landing {
    max-width: 960px;
    margin: 0 auto;
    padding: 48px 24px;
  }
  .hero {
    display: flex;
    gap: 32px;
    align-items: center;
    flex-wrap: wrap;
  }
  .cover {
    border-radius: 8px;
    border: 1px solid #14324a;
    box-shadow: 0 0 50px rgba(77, 208, 255, 0.18);
    max-width: 100%;
    height: auto;
  }
  .hero-text { flex: 1; min-width: 260px; }
  h1 {
    font-size: clamp(28px, 5vw, 48px);
    margin: 0 0 12px;
    letter-spacing: 0.02em;
    color: #eaf6ff;
  }
  .tagline {
    font-size: 16px;
    line-height: 1.6;
    color: #9fc4dd;
    margin: 0 0 24px;
  }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 6px;
    border: 1px solid #2a5f86;
    color: #cfe6ff;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.03em;
    transition: transform 0.12s ease, background 0.12s ease;
  }
  .btn:hover { transform: translateY(-2px); background: #0e2436; }
  .btn.primary {
    background: #1287c4;
    border-color: #4dd0ff;
    color: #06121b;
  }
  .btn.primary:hover { background: #4dd0ff; }
  .info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin: 56px 0;
  }
  .card {
    background: #0b1a28;
    border: 1px solid #14324a;
    border-radius: 8px;
    padding: 24px;
  }
  .card h2 {
    margin: 0 0 14px;
    font-size: 18px;
    color: #4dd0ff;
    letter-spacing: 0.05em;
  }
  .card ul { margin: 0; padding-left: 20px; line-height: 1.9; color: #a9c8de; }
  .credits {
    border-top: 1px solid #14324a;
    padding-top: 28px;
    margin-top: 40px;
    line-height: 1.7;
    color: #8fb4cc;
  }
  .muted { color: #56788f; font-size: 13px; letter-spacing: 0.06em; }
</style>
