  function createManualInsideTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
    ctx.imageSmoothingEnabled = false;

    ctx.fillStyle = '#070E16';
    ctx.fillRect(0, 0, 256, 256);
    ctx.strokeStyle = '#10F57A';
    ctx.lineWidth = 4;
    ctx.strokeRect(10, 10, 236, 236);

    ctx.fillStyle = '#FFD23F';
    ctx.font = 'bold 16px monospace';
    ctx.fillText('OPERATION MANUAL', 26, 40);

    ctx.fillStyle = '#00F0FF';
    ctx.font = 'bold 12px monospace';
    ctx.fillText('WASD : MOVE CURSOR', 26, 76);
    ctx.fillText('U    : ACTION 1', 26, 100);
    ctx.fillText('I    : ACTION 2', 26, 124);
    ctx.fillText('ENTER: START', 26, 148);

    ctx.fillStyle = '#10F57A';
