---
import Base from '../layouts/Base.astro';
---

<Base
  title="CATATUMBO PROTOCOL — 1996 SEGA Saturn / PSX Archive Edition"
  description="Combate táctico de mechas 1v1 por turnos simultáneos sobre el Lago de Maracaibo. Archive Edition para navegador."
>
  <div id="content" class="landing-shell starfield-radar-bg">
    <!-- Capa CRT -->
    <div class="crt-overlay" aria-hidden="true"></div>

    <!-- ===================================================================== -->
    <!-- ESCENARIO 3D INTERACTIVO -->
    <div id="three-stage" title="Arrastra para girar la caja en 360°"></div>

    <!-- PISTA DE SCROLL -->
    <div id="scroll-track" aria-hidden="true"></div>

    <!-- ===================================================================== -->
    <!-- OVERLAYS DE ZONA: el copy vive sobre la caja 3D; solo el activo se ve. -->
    <!-- ===================================================================== -->
    <div id="zone-layer" class="zone-layer">

      <!-- STOP 01 — CARÁTULA (frente) -->
      <article class="zone-copy zone-copy--hero" data-stop="0">
        <div class="zone-card">
          <div class="zone-topline">
            <span class="pixel-font text-[10px] text-[#FFD23F]">ARCHIVE EDITION • NTSC-U • SLUS-1996-MCBO</span>
            <span class="mono-font text-[11px] text-[#00F0FF] font-bold">SCROLL: GIRA LA CAJA ↓</span>
          </div>
          <h1 class="virtual-title text-4xl sm:text-5xl md:text-6xl leading-none">CATATUMBO</h1>
          <h2 class="virtual-subtitle text-3xl sm:text-4xl md:text-5xl leading-tight mt-1">PROTOCOL</h2>
          <p class="zone-lead">
            Duelo de mechas <strong>1v1 por turnos simultáneos</strong> sobre el Lago de Maracaibo.
            Ambos pilotos comprometen su maniobra en secreto y la resuelven a la vez.
          </p>
          <p class="zone-body">
            Predice al rival, encadena <strong>posturas</strong>, gasta <strong>Guts</strong> en especiales
            y sobrevive al relámpago eterno del Catatumbo.
          </p>
          <div class="zone-cta-wrap">
            <a href="/play" class="play-cta" aria-label="Jugar Catatumbo Protocol">
              <span class="play-cta__coin" aria-hidden="true">&#9654;</span>
              <span class="play-cta__body">
                <span class="play-cta__label pixel-font">JUGAR</span>
                <span class="play-cta__sub mono-font"><span class="blink-coin">INSERT COIN</span> &middot; MODOS Y M&Aacute;QUINAS DENTRO DEL JUEGO</span>
              </span>
              <span class="play-cta__arrow" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>
      </article>

      <!-- STOP 02 — LOMO / OBI STRIP (ficha técnica + mechas) -->
      <article class="zone-copy zone-copy--left" data-stop="1">
        <div class="zone-card">
          <div class="zone-topline">
            <span class="pixel-font text-[11px] text-[#00F0FF]">MACHINE SELECT</span>
            <span class="mono-font text-[11px] text-slate-300">OBI: SLUS-1996-MCBO</span>
          </div>
          <h2 class="zone-title">FICHA TÉCNICA</h2>
          <dl class="zone-spec">
            <div><dt>ORIGEN</dt><dd>Platanus Hack 26 · Caracas, VE</dd></div>
            <div><dt>ESTUDIO</dt><dd>ERRACODE</dd></div>
            <div><dt>GÉNERO</dt><dd>Táctica isométrica · turnos simultáneos</dd></div>
            <div><dt>JUGADORES</dt><dd>1 (CPU) / 2 (online)</dd></div>
            <div><dt>PLATAFORMA</dt><dd>Navegador · Phaser 3.87</dd></div>
            <div><dt>FORMATO</dt><dd>1 archivo · 0 assets · juego 100% procedural</dd></div>
          </dl>
          <div class="zone-bottomline"><span class="pixel-font text-[10px] text-[#FF2A55]">› 3 VIRTUALOIDS EN EL CARTUCHO ‹</span></div>
          <div class="zone-mech-detail">
            <div id="mech-blueprint-svg" class="zone-blueprint" aria-hidden="true"></div>
            <div class="zone-mech-meta">
              <div id="bp-code" class="mono-font text-[11px] text-[#FFD23F] font-bold">MBV-04-MCBO</div>
              <div id="bp-name" class="display-font text-lg font-bold italic text-[#00F0FF] leading-none">VR.RELAMPAGO</div>
              <div id="bp-weapons" class="mono-font text-[11px] text-[#FFD23F] font-bold leading-snug">RAYO OCULTO · CORTE V/H</div>
              <div id="bp-stats" class="mono-font text-[10px] text-slate-300">HP: 160 | VEL: ALTA | POSTURA: BALANCE</div>
              <div id="bp-sector" class="pixel-font text-[10px] text-[#00F0FF]">SECTOR: PUENTE RAFAEL URDANETA</div>
            </div>
          </div>
          <div class="zone-mechs">
            <div id="mech-card-0" class="mech-card active" role="img" aria-label="Máquina VR.RELAMPAGO: equilibrada, rayo">
              <span class="mono-font text-[11px] text-[#00F0FF] font-bold">VR.RELAMPAGO</span>
              <span class="mono-font text-[10px] text-slate-400">Equilibrado · Rayo</span>
            </div>
            <div id="mech-card-1" class="mech-card" role="img" aria-label="Máquina VR.PALAFITO: anfibia, evasión">
              <span class="mono-font text-[11px] text-[#10F57A] font-bold">VR.PALAFITO</span>
              <span class="mono-font text-[10px] text-slate-400">Anfibio · Evasión</span>
            </div>
            <div id="mech-card-2" class="mech-card" role="img" aria-label="Máquina VR.URDANETA: pesada, cañón">
              <span class="mono-font text-[11px] text-[#FF2A55] font-bold">VR.URDANETA</span>
              <span class="mono-font text-[10px] text-slate-400">Pesado · Cañón</span>
            </div>
          </div>
          <span class="zone-mini-cta mono-font text-[12px]">ELEGIR EN EL JUEGO ▶</span>
        </div>
      </article>

      <!-- STOP 03 — CONTRAPORTADA (dorso amarillo) -->
      <article class="zone-copy zone-copy--right" data-stop="2">
        <div class="saturn-backcover zone-backcover">
          <div class="zone-topline">
            <span class="pixel-font text-[9px] bg-black text-[#FFD23F] px-2 py-0.5">SEGA SATURN / PSX · 1996</span>
            <span class="mono-font text-[10px] text-black/70 font-bold">1 OR 2 PLAYERS</span>
          </div>
          <h2 class="text-lg sm:text-xl font-bold italic uppercase tracking-tight text-black leading-tight">
            ¡ARMAGEDÓN TÁCTICO SOBRE EL LAGO DE MARACAIBO!
          </h2>
          <p class="mono-font text-[12px] font-bold text-black/90 leading-snug">
            Pilota tu Virtualoid en duelos tácticos simultáneos. Acciones secretas, orden por velocidad y el relámpago eterno del Catatumbo.
          </p>
          <div class="zone-shots">
            <figure><div class="vo-frame"><canvas id="shot-1" width="320" height="145" class="w-full h-auto block"></canvas></div><figcaption><strong>Duelo:</strong> ambos eligen en secreto.</figcaption></figure>
            <figure><div class="vo-frame"><canvas id="shot-2" width="320" height="145" class="w-full h-auto block"></canvas></div><figcaption><strong>Rayo Catatumbo:</strong> 12 DMG.</figcaption></figure>
            <figure><div class="vo-frame"><canvas id="shot-3" width="320" height="145" class="w-full h-auto block"></canvas></div><figcaption><strong>Palafitos:</strong> rompe cobertura.</figcaption></figure>
            <figure><div class="vo-frame"><canvas id="shot-4" width="320" height="145" class="w-full h-auto block"></canvas></div><figcaption><strong>Posturas:</strong> encadena y remata.</figcaption></figure>
          </div>
          <div class="zone-barcode">
            <div class="barcode-bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <span class="mono-font text-[9px] font-bold tracking-widest text-black">0 10086 81042 4 · K-A</span>
          </div>
        </div>
      </article>

      <!-- STOP 04a — ESQUINA INTERIOR TAPA (ORIGEN / HISTORIA) -->
      <article class="zone-copy zone-copy--left" data-stop="3">
        <div class="zone-card">
          <div class="zone-label pixel-font text-[11px] text-[#FFD23F]">ORIGEN</div>
          <h2 class="zone-title">¿POR QUÉ EL CATATUMBO?</h2>
          <p class="zone-body">
            Una carta de amor al arcade japonés de los 90 —los <em>Cyber Troopers</em> de Virtual-On,
            la táctica por turnos de <em>Mecha Simultactics</em>— plantada en suelo venezolano.
          </p>
          <p class="zone-body">
            El escenario no es genérico: es el <strong>Lago de Maracaibo</strong>, atravesado por el
            <strong>Puente Rafael Urdaneta</strong> y salpicado de <strong>palafitos</strong>. Y sobre todo,
            la tierra del <strong>Relámpago del Catatumbo</strong>: una tormenta casi permanente que
            ilumina la noche zuliana. Ese relámpago no es decoración — es una mecánica de peligro
            que cae sobre el tablero y castiga a quien estacione mal.
          </p>
          <p class="zone-body">
            Los rivales llevan nombres de ciudades del Zulia: <strong>Cabimas, San Francisco,
            Ciudad Ojeda, Santa Rita, Mene Grande</strong>. El jefe final es <strong>Catatumbo</strong> mismo.
          </p>
        </div>
      </article>

      <!-- STOP 04b — MANUAL INTERIOR (CÓMO SE HIZO) -->
      <article class="zone-copy zone-copy--right" data-stop="4">
        <div class="zone-card">
          <div class="zone-label pixel-font text-[11px] text-[#00F0FF]">CÓMO SE HIZO</div>
          <h2 class="zone-title">INGENIERÍA EN UN ARCHIVO</h2>
          <p class="zone-body">
            El reto no fue diseñar el juego: fue que <strong>arte, sonido y netcode</strong> vivieran en
            un solo archivo, sin cargar un solo asset.
          </p>
          <ul class="zone-facts">
            <li><span class="mono-font text-[#00F0FF] font-bold">ARTE:</span> todo se dibuja con Graphics de Phaser y texturas de canvas en runtime.</li>
            <li><span class="mono-font text-[#00F0FF] font-bold">AUDIO:</span> cero .mp3. Todo sintetizado con la Web Audio API.</li>
            <li><span class="mono-font text-[#00F0FF] font-bold">BYTES:</span> IIFE, renombrado de ~648 props y minificado con SWC.</li>
            <li><span class="mono-font text-[#00F0FF] font-bold">ONLINE:</span> netcode <em>host-authoritative</em>: el host resuelve y broadcastea; cero desync.</li>
          </ul>
          <dl class="zone-spec">
            <div><dt>CONTROLES</dt><dd>WASD mueve · U acc.1 · I acc.2 · Enter start</dd></div>
          </dl>
        </div>
      </article>

      <!-- STOP 04c — CD SUPERFICIE (MÚSICA) -->
      <article class="zone-copy zone-copy--left" data-stop="5">
        <div class="zone-card">
          <div class="zone-label pixel-font text-[11px] text-[#FFD23F]">BANDA SONORA</div>
          <h2 class="zone-title">"COQUIVACOA STEEL"</h2>
          <p class="zone-body">
            El corazón venezolano: una <strong>gaita zuliana cruzada con techno</strong>. La gaita
            —tambora, charrasca, cuatro y furruco— reimaginada como loop de combate a
            <strong>185 BPM</strong> sobre tripletes de 12 pasos.
          </p>
          <ul class="zone-facts">
            <li><span class="mono-font text-[#FFD23F] font-bold">TAMBORA</span> patrón 6/8 · <span class="mono-font text-[#FFD23F] font-bold">CHARRASCA</span> raspado</li>
            <li><span class="mono-font text-[#FFD23F] font-bold">CUATRO</span> strum con delay LFO 0–3 ms</li>
            <li><span class="mono-font text-[#FFD23F] font-bold">FURRUCO</span> low-end · arpegio de tripletes</li>
            <li>Kick 170→40 Hz · progresión i–iv–V–i en La menor · 8 compases</li>
          </ul>
          <p class="zone-footnote mono-font text-[11px] text-slate-400">
            Coquivacoa es el nombre indígena del lago. Es gaita, es techno, es Zulia.
          </p>
        </div>
      </article>

      <!-- STOP 04d — CENTRO DEL CD (GAMEPLAY + CTA) -->
      <article class="zone-copy zone-copy--left" data-stop="6">
        <div class="zone-card">
          <div class="zone-label pixel-font text-[11px] text-[#00F0FF]">GAMEPLAY</div>
          <h2 class="zone-title">CÓMO SE JUEGA</h2>
          <p class="zone-lead">
            Duelo <strong>1v1 por turnos simultáneos</strong> en tablero isométrico. Elegís sin ver la
            acción rival; ambas se resuelven juntas, ordenadas por <strong>velocidad</strong>.
          </p>
          <dl class="zone-spec">
            <div><dt>MOVIMIENTO</dt><dd>mover · dodge · teleport · pivot</dd></div>
            <div><dt>ATAQUE</dt><dd>V-Slash · H-Slash · jab · lunge · parry · block · grab</dd></div>
            <div><dt>ESPECIAL</dt><dd>40 Guts: Rayo · Orbe · Carga · Vent</dd></div>
            <div><dt>POSTURAS</dt><dd>Normal → Staggered → Knockback → Down</dd></div>
            <div><dt>HAZARDS</dt><dd>Catatumbo 12 · Verdín 8 · Oil 10 · Puente 8</dd></div>
          </dl>
        </div>
      </article>


    <!-- ===================================================================== -->
    <!-- HUD INFERIOR DE PROGRESO + CONTROL MANUAL DE TAPA Y CD                -->
    <!-- ===================================================================== -->
    <div class="fixed bottom-3 left-3 right-3 z-40 pointer-events-none">
      <div class="max-w-4xl mx-auto bg-[#05070A]/95 border border-slate-700 px-3.5 py-2 flex flex-wrap items-center justify-between gap-2 shadow-[4px_4px_0px_#000000] pointer-events-auto">
        <div class="flex items-center gap-2.5">
          <span id="hud-stage-label" class="pixel-font text-[9px] sm:text-[10px] text-[#FFD23F] tabular-nums">
            01 / 04 • PORTADA
          </span>
          <div class="w-24 sm:w-36 h-2 bg-slate-800 border border-slate-600">
            <div id="scroll-progress-bar" class="h-full bg-gradient-to-r from-[#00F0FF] via-[#FFD23F] to-[#10F57A] w-0 transition-[width] duration-150 ease-out"></div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span class="mono-font text-[11px] text-slate-400 hidden sm:inline">Arrastra caja 360°</span>
          <button type="button" id="btn-bgm" class="btn-brutal bg-[#FFD23F] text-black pixel-font text-[9px] px-2.5 py-1 font-bold cursor-pointer" aria-pressed="false" aria-label="Reproducir la banda sonora Coquivacoa Steel">
            <span class="bgm-icon bgm-icon--play" aria-hidden="true">♪</span>
            <span class="bgm-icon bgm-icon--stop bgm-hidden" aria-hidden="true">■</span>
            <span class="bgm-label">MÚSICA</span>
          </button>
          <button type="button" id="btn-manual-lid" class="btn-brutal bg-[#00F0FF] text-black pixel-font text-[9px] px-2.5 py-1 font-bold cursor-pointer">
            ABRIR / CERRAR TAPA
          </button>
          <a href="/play" class="btn-brutal hud-cta bg-[#FF2A55] hover:bg-[#ff3b63] text-white pixel-font text-[10px] px-3 py-1.5 font-bold cursor-pointer" aria-label="Jugar Catatumbo Protocol ahora">
            <span aria-hidden="true">&#9654;</span> JUGAR
          </a>
        </div>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  :root {
    --space-black: #05070a;
    --saturn-yellow: #ffd23f;
    --holo-cyan: #00f0ff;
    --radar-green: #10f57a;
    --arcade-red: #ff2a55;
    --vo-pink: #e60067;
    --vo-mint: #5eead4;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  }

  /* 100% esquinas rectas industriales (0px border-radius en toda la UI) */
  .landing-shell *,
  .landing-shell *::before,
  .landing-shell *::after {
    box-sizing: border-box;
    border-radius: 0px !important;
    image-rendering: pixelated;
  }

  html {
    scroll-behavior: smooth;
  }

  /* Override the shared Base.astro body background for the landing only. */
  body {
    background-color: var(--space-black);
    color: #f1f5f9;
    font-family: 'Space Grotesk', sans-serif;
    overflow-x: hidden;
    margin: 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .landing-shell {
    min-height: 100vh;
    position: relative;
  }

  /* Fondo espacial estrellado + grilla radar verde del Lago de Maracaibo */
  .starfield-radar-bg {
    background-color: #05070a;
    background-image:
      linear-gradient(to right, rgba(16, 245, 122, 0.09) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(16, 245, 122, 0.09) 1px, transparent 1px),
      radial-gradient(1px 1px at 24px 36px, #ffffff, transparent),
      radial-gradient(2px 2px at 90px 130px, #00f0ff, transparent),
      radial-gradient(1px 1px at 210px 70px, #ffd23f, transparent),
      radial-gradient(2px 2px at 280px 200px, #ffffff, transparent);
    background-size: 32px 32px, 32px 32px, 320px 240px, 320px 240px, 320px 240px, 320px 240px;
  }

  /* Scanlines CRT sutiles */
  .crt-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 60;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.22) 50%);
    background-size: 100% 3px;
  }

  .pixel-font {
    font-family: 'Geist Pixel', 'Silkscreen', monospace;
    letter-spacing: 0.03em;
  }

  .mono-font {
    font-family: 'JetBrains Mono', monospace;
  }

  .display-font {
    font-family: 'Space Grotesk', sans-serif;
  }

  /* Títulos inclinados estilo Virtual On: Cyber Troopers */
  .virtual-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, #fff7cc 0%, #ffd23f 55%, #f59e0b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(3px 3px 0px #ff2a55) drop-shadow(5px 5px 0px #000000);
    text-wrap: balance;
  }

  .virtual-subtitle {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, #e0ffff 0%, #00f0ff 65%, #0284c7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(2px 2px 0px #000000);
  }

  /* Botones brutalistas con borde industrial 1px-2px y sombra dura */
  .btn-brutal {
    border: 2px solid #000000;
    box-shadow: 4px 4px 0px #000000;
    transition:
      transform 0.12s var(--ease-out),
      box-shadow 0.12s var(--ease-out),
      background-color 0.14s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .btn-brutal:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px #000000;
    }
  }
  .btn-brutal:active {
    transform: translate(2px, 2px) scale(0.99);
    box-shadow: 2px 2px 0px #000000;
  }
  .btn-brutal:focus-visible {
    outline: 2px solid #00f0ff;
    outline-offset: 3px;
  }

  /* Contraportada amarilla estilo SEGA Saturn */
  .saturn-backcover {
    background-color: var(--saturn-yellow);
    color: #05070a;
    border: 2px solid #000000;
    box-shadow: 0 0 0 2px var(--saturn-yellow), 8px 8px 0px #000000;
  }

  /* Marco rojo de capturas estilo Virtual On */
  .vo-frame {
    border: 2px solid #e11d48;
    box-shadow: inset 0 0 0 1px #000000, 3px 3px 0px #000000;
    background: #061217;
  }

  /* Tarjetas informativas de mecha (no clickeables) */
  .mech-card {
    border: 1px solid #334155;
    background: #070e16;
  }

  /* BGM toggle: cross-faded icon swap (scale 0.25 -> 1, blur 4px -> 0) and a
     40x40+ hit area; UI animations stay under 300ms with ease-out. */
  #btn-bgm {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
  }
  #btn-bgm:active {
    transform: translate(2px, 2px) scale(0.96);
  }
  .bgm-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    transition:
      opacity 0.18s var(--ease-out),
      transform 0.18s var(--ease-out),
      filter 0.18s var(--ease-out);
  }
  .bgm-icon--stop {
    position: absolute;
  }
  .bgm-hidden {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }
  #btn-bgm.is-playing .bgm-icon--play {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }
  #btn-bgm.is-playing .bgm-icon--stop {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }
  #btn-bgm.is-playing {
    background: #00f0ff;
  }

  @keyframes blinkInsert {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0.25;
    }
  }
  .blink-coin {
    animation: blinkInsert 1.1s infinite;
  }

  /* Escenario 3D fijo a pantalla completa */
  #three-stage {
    position: fixed;
    inset: 0;
    z-index: 10;
    cursor: grab;
  }
  #three-stage:active {
    cursor: grabbing;
  }
  /* Warp-speed glow behind the jewel case, above the starfield CSS layer */
  #three-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 50% 50%, rgba(0, 240, 255, 0.1) 0%, transparent 60%),
      radial-gradient(40% 40% at 50% 50%, rgba(255, 210, 63, 0.05) 0%, transparent 70%);
  }

  /* Pista de Scrollytelling de 7 paradas (~700vh) */
  #scroll-track {
    position: relative;
    height: 700vh;
    z-index: 20;
    pointer-events: none;
  }

  /* =========================================================================
     OVERLAYS DE ZONA — el copy vive sobre la caja; solo el activo se ve.
     ========================================================================= */
  .zone-layer {
    position: fixed;
    inset: 0;
    z-index: 26;
    pointer-events: none;
  }

  .zone-copy {
    position: absolute;
    display: flex;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
    padding-top: 64px;
    padding-bottom: 60px;
    will-change: opacity, transform;
  }

  .zone-copy.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Enter: split into chunks and stagger (~60ms), per stop activation. */
  .zone-card > * {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
    transition-delay: 0ms;
  }
  .zone-copy.is-active .zone-card > * {
    opacity: 1;
    transform: translateY(0);
  }
  .zone-copy.is-active .zone-card > *:nth-child(2) { transition-delay: 60ms; }
  .zone-copy.is-active .zone-card > *:nth-child(3) { transition-delay: 120ms; }
  .zone-copy.is-active .zone-card > *:nth-child(4) { transition-delay: 180ms; }
  .zone-copy.is-active .zone-card > *:nth-child(5) { transition-delay: 240ms; }
  .zone-copy.is-active .zone-card > *:nth-child(6) { transition-delay: 300ms; }
  .zone-copy.is-active .zone-card > *:nth-child(7) { transition-delay: 360ms; }
  .zone-copy.is-active .zone-card > *:nth-child(8) { transition-delay: 420ms; }
  /* Exit (default state): retargets for a quick soft settle, no extra delay. */
  .zone-copy:not(.is-active) .zone-card > * {
    transition-delay: 0ms;
    transition-duration: 0.15s;
  }

